<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Makhanani LTSM — Teachers CSV Upload v1.0</title>
<meta name="theme-color" content="#0a1f4d">
<link rel="icon" type="image/png" href="logo.png">
<style>
*{box-sizing:border-box}body{font-family:Arial,sans-serif;margin:0;background:#f1f5f9;color:#111}header{background:#0a1f4d;color:#fff;padding:18px;text-align:center}header h1{margin:0;font-size:22px}header p{margin:6px 0 0;opacity:.9;font-size:13px}main{max-width:900px;margin:auto;padding:14px}.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:14px;box-shadow:0 2px 8px rgba(0,0,0,.08)}h2{margin:0 0 10px;color:#0a1f4d;font-size:18px;border-bottom:2px solid #d4af37;padding-bottom:6px}label{font-weight:700;font-size:13px;display:block;margin:12px 0 4px}input,select{width:100%;padding:13px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:15px;background:#fff}.btn{width:100%;padding:13px;border:none;border-radius:8px;font-weight:900;font-size:15px;cursor:pointer;margin-top:12px}.btn-blue{background:#0a1f4d;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}.btn-green{background:#059669;color:#fff}.btn-grey{background:#e2e8f0}.info{background:#dbeafe;border:1.5px solid #2563eb;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}.warn{background:#fee2e2;border:1.5px solid #dc2626;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}.ok{background:#dcfce7;border:1.5px solid #059669;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}.goldBox{background:#fef3c7;border:2px solid #d4af37;border-radius:12px;padding:12px;margin-top:10px;font-size:13px}.small{font-size:12px;color:#64748b}.topnav{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;justify-content:center}.topnav a{background:#e2e8f0;color:#0a1f4d;text-decoration:none;padding:8px 12px;border-radius:20px;font-weight:900;font-size:12px}table{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}th,td{border:1px solid #e2e8f0;padding:8px;text-align:left}th{background:#0a1f4d;color:#fff}textarea{width:100%;min-height:120px;padding:10px;border:1.5px solid #cbd5e1;border-radius:8px;font-family:monospace;font-size:13px}
</style>
</head>
<body>
<header><h1>👩🏾‍🏫 Makhanani LTSM — Teachers CSV Upload v1.0</h1><p>Xintimani Group (Pty) Ltd • <span id="whoLine">Not logged in</span><br>Upload 20 Teachers In 1 Minute — No Firebase Console</p></header>
<main>
<div class="card">
<div class="topnav"><a href="index.html">🏠 Home</a><a href="teachers.html">👩🏾‍🏫 Teachers</a><a href="csv-upload.html">📥 Learners / Books CSV</a><a href="librarian.html">📚 Librarian</a><a href="issue.html">📚 Issue / Return</a><a href="profile.html">👤 Profile</a></div>
<div class="info" id="loginInfo">Checking login...</div>
<div id="blockedBox" class="warn" style="display:none">🔒 Not logged in. Go to <a href="index.html">Login</a> first. Admin / Principal / Librarian only.</div>
</div>
<div id="body" style="display:none">
<div class="card">
<h2>📥 Step 1 — Download Template</h2>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
<button class="btn btn-gold" onclick="downloadTemplate()">📥 Download Template CSV</button>
<button class="btn btn-blue" onclick="downloadExample()">📋 Download Example With 5 Teachers</button>
</div>
<div class="goldBox"><b>Header must be exactly:</b><br><code>name,email,phone,subjects,grades,classes,password,role</code><br>• <b>name + email + subjects</b> = Required<br>• <b>subjects</b> — ALL CAPS, separate with <b>;</b> e.g. <code>ACCOUNTING;MATHEMATICS</code><br>• <b>password</b> — Optional, blank = <code>1234</code> — Teacher changes in Profile<br>• <b>role</b> — Optional, blank = <code>TEACHER</code> — Use <code>ADMIN</code> / <code>LIBRARIAN</code> / <code>PRINCIPAL</code> if needed<br>• <b>grades / classes</b> — Optional, separate with <b>;</b> e.g. <code>Grade 10;Grade 11</code></div>
</div>
<div class="card">
<h2>📋 Step 2 — Paste OR Choose File</h2>
<label>Option A — Paste CSV Text Here</label>
<textarea id="pasteBox" placeholder="Paste CSV here...&#10;name,email,phone,subjects,grades,classes,password,role&#10;Vusi Chauke,vusi@makhanani.co.za,0821234567,ACCOUNTING;MATHEMATICS,Grade 10;Grade 11,10A;11B,1234,TEACHER"></textarea>
<label>Option B — Choose .csv File</label>
<input type="file" id="fileInput" accept=".csv,text/csv">
<button class="btn btn-blue" onclick="previewCSV()">👀 Preview — Check For Errors</button>
<div id="previewMsg"></div>
<div id="previewTable"></div>
</div>
<div class="card" id="uploadCard" style="display:none">
<h2>🚀 Step 3 — Upload To Firebase</h2>
<div class="goldBox" id="uploadSummary"></div>
<label><input type="checkbox" id="createUsers" checked style="width:auto"> ✅ Also create Login Users (so teachers can login with email + password)</label>
<div class="small">If unchecked, teachers are added to Teachers list only, no login. Keep checked for normal use.</div>
<button class="btn btn-green" onclick="uploadAll()">🚀 Upload All <span id="uploadCount"></span> To Firebase</button>
<div id="uploadMsg"></div>
<div id="uploadProgress"></div>
</div>
</div>
</main>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, setDoc, doc, addDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
const firebaseConfig = { apiKey: "AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA", authDomain: "makhanani-ltsm.firebaseapp.com", databaseURL: "https://makhanani-ltsm-default-rtdb.firebaseio.com", projectId: "makhanani-ltsm", storageBucket: "makhanani-ltsm.firebasestorage.app", messagingSenderId: "247180363183", appId: "1:247180363183:web:760b5163fdf421bae01b5a", measurementId: "G-TDFSSF6NTB" };
let db; try{ const app=initializeApp(firebaseConfig); db=getFirestore(app); }catch(e){}
const $ = id => document.getElementById(id);
function esc(s){ return String(s??'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function getLogin(){ try{ return JSON.parse(localStorage.getItem('MAKHANANI_LOGGED_IN')||'null'); }catch(e){ return null; } }
let login=getLogin(); let parsedRows=[], existingTeachers=[], existingUsers=[];
function normalizeSubject(s){ let x=String(s||'').trim().toUpperCase(); const map={'MATHS':'MATHEMATICS','MATH':'MATHEMATICS','MATHS LITERACY':'MATHEMATICAL LITERACY','MATH LITERACY':'MATHEMATICAL LITERACY','ENGLISH':'ENGLISH HOME LANGUAGE','ENG':'ENGLISH HOME LANGUAGE','AFRIKAANS':'AFRIKAANS HOME LANGUAGE','SCIENCE':'NATURAL SCIENCES','PHYSICAL SCIENCE':'PHYSICAL SCIENCES','LIFE SCIENCE':'LIFE SCIENCES','ACCOUNTANCY':'ACCOUNTING','BUSINESS':'BUSINESS STUDIES','ECON':'ECONOMICS','GEO':'GEOGRAPHY','HIST':'HISTORY','LO':'LIFE ORIENTATION','CAT':'COMPUTER APPLICATIONS TECHNOLOGY','IT':'INFORMATION TECHNOLOGY','EGD':'ENGINEERING GRAPHICS AND DESIGN','EMS':'ECONOMIC AND MANAGEMENT SCIENCES','SS':'SOCIAL SCIENCES','TECH':'TECHNOLOGY','ART':'CREATIVE ARTS'}; if(map[x]) return map[x]; return x; }
function deptOf(subject){ const s=normalizeSubject(subject); if(s.includes('ENGLISH')||s.includes('AFRIKAANS')||s.includes('LANGUAGE')||s.includes('ISIZULU')||s.includes('ISIXHOSA')||s.includes('SEPEDI')) return 'LANGUAGES'; if(s.includes('MATH')) return 'MATHEMATICS'; if(s.includes('SCIENCE')||s.includes('COMPUTER')||s.includes('INFORMATION')) return 'SCIENCES'; if(s.includes('GEOGRAPHY')||s.includes('HISTORY')||s.includes('LIFE ORIENTATION')||s.includes('SOCIAL')) return 'HUMANITIES'; if(s.includes('ACCOUNT')||s.includes('BUSINESS')||s.includes('ECONOM')||s.includes('TOURISM')) return 'COMMERCE'; if(s.includes('ART')||s.includes('DESIGN')||s.includes('TECHNOLOGY')) return 'ARTS / TECHNOLOGY'; return 'OTHER'; }
function displayGrade(raw){ let s=String(raw||'').trim(); if(!s) return ''; if(s.toUpperCase()==='R'||s.toUpperCase()==='GRADE R') return 'Grade R'; const m=s.match(/(\d{1,2})/); if(m){ const n=parseInt(m[1],10); if(n>=1&&n<=12) return 'Grade '+n; } return s; }
function parseCSV(text){
  const lines=String(text||'').replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n').filter(l=>l.trim().length>0);
  if(!lines.length) return {header:[], rows:[]};
  function splitLine(line){ const out=[]; let cur='', inQ=false; for(let i=0;i<line.length;i++){ const c=line[i]; if(c==='"'){ if(inQ && line[i+1]==='"'){ cur+='"'; i++; } else inQ=!inQ; } else if(c===',' && !inQ){ out.push(cur); cur=''; } else cur+=c; } out.push(cur); return out.map(x=>x.trim().replace(/^"|"$/g,'')); }
  const header=splitLine(lines[0]).map(h=>h.toLowerCase().trim());
  const rows=lines.slice(1).map(line=>{ const vals=splitLine(line); const obj={}; header.forEach((h,i)=>{ obj[h]=vals[i]||''; }); return obj; });
  return {header, rows};
}
window.downloadTemplate=function(){ const csv='name,email,phone,subjects,grades,classes,password,role\n'; const blob=new Blob([csv],{type:'text/csv'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='teachers-template.csv'; a.click(); };
window.downloadExample=function(){
  const csv='name,email,phone,subjects,grades,classes,password,role\nVusi Chauke,vusi@makhanani.co.za,0821234567,ACCOUNTING;MATHEMATICS,Grade 10;Grade 11,10A;11B,1234,TEACHER\nThandi Molefe,thandi@school.co.za,0827654321,ENGLISH HOME LANGUAGE,Grade 10,10A,1234,TEACHER\nSipho Nkosi,sipho@school.co.za,0821112222,PHYSICAL SCIENCES;MATHEMATICS,Grade 11;Grade 12,11A;12A,1234,TEACHER\nLerato Dube,lerato@school.co.za,0823334444,GEOGRAPHY;HISTORY,Grade 9;Grade 10,9C;10B,1234,TEACHER\nNaledi Khumalo,naledi@school.co.za,0825556666,LIFE ORIENTATION,Grade 8;Grade 9,8A;9A,1234,LIBRARIAN\n';
  const blob=new Blob([csv],{type:'text/csv'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='teachers-example.csv'; a.click();
};
window.previewCSV=async function(){
  let text=$('pasteBox').value||''; const file=$('fileInput').files[0];
  if(file){ text=await file.text(); $('pasteBox').value=text; }
  if(!text.trim()){ $('previewMsg').innerHTML='<div class="warn">⚠️ Paste CSV or Choose File first.</div>'; return; }
  const {header, rows}=parseCSV(text);
  const need=['name','email','subjects']; const missing=need.filter(n=>!header.includes(n));
  if(missing.length){ $('previewMsg').innerHTML='<div class="warn">❌ Wrong header. Missing: <b>'+missing.join(', ')+'</b><br>Your header: <code>'+esc(header.join(', '))+'</code><br>Expected: <code>name,email,phone,subjects,grades,classes,password,role</code><br>Click <b>Download Template</b>.</div>'; return; }
  try{
    const base='EMIS_'+login.emis;
    const [ts, us]=await Promise.all([ getDocs(collection(db,'schools',base,'teachers')), getDocs(collection(db,'schools',base,'users')) ]);
    existingTeachers=[]; ts.forEach(d=>existingTeachers.push({id:d.id,...d.data()}));
    existingUsers=[]; us.forEach(d=>existingUsers.push({id:d.id,...d.data()}));
  }catch(e){}
  parsedRows=[]; let errors=[], warnings=[];
  rows.forEach((r, idx)=>{
    const lineNo=idx+2;
    const name=(r.name||'').trim(); const email=(r.email||'').trim().toLowerCase(); const subjectsRaw=(r.subjects||'').trim();
    if(!name) errors.push('Row '+lineNo+': Missing name');
    if(!email) errors.push('Row '+lineNo+': Missing email for '+name);
    else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push('Row '+lineNo+': Invalid email <b>'+esc(email)+'</b>');
    if(!subjectsRaw) errors.push('Row '+lineNo+': Missing subjects for '+name);
    const subjects=subjectsRaw.split(';').map(s=>normalizeSubject(s)).filter(Boolean);
    const grades=(r.grades||'').split(';').map(s=>displayGrade(s)).filter(Boolean);
    const classes=(r.classes||'').split(';').map(s=>s.trim()).filter(Boolean);
    const dupT=existingTeachers.find(x=>String(x.email||'').trim().toLowerCase()===email);
    if(dupT) warnings.push('Row '+lineNo+': Teacher <b>'+esc(name)+'</b> already in Teachers list — Will UPDATE, not duplicate.');
    const dupU=existingUsers.find(x=>String(x.email||'').trim().toLowerCase()===email);
    if(dupU) warnings.push('Row '+lineNo+': Login User <b>'+esc(email)+'</b> already exists — Will UPDATE password/role, not duplicate.');
    const departments=[...new Set(subjects.map(s=>deptOf(s)))];
    parsedRows.push({name, email, phone:(r.phone||'').trim(), subjects, subjectsStr:subjects.join('; '), departments, grades, gradesStr:grades.join('; '), classes, classesStr:classes.join('; '), password:(r.password||'').trim()||'1234', role:((r.role||'TEACHER').trim().toUpperCase()||'TEACHER'), _line:lineNo});
  });
  let msg='';
  if(errors.length) msg+='<div class="warn">❌ <b>'+errors.length+' error(s) — Fix before upload:</b><br>'+errors.slice(0,20).join('<br>')+'</div>';
  if(warnings.length) msg+='<div class="goldBox">⚠️ <b>'+warnings.length+' warning(s):</b><br>'+warnings.slice(0,10).join('<br>')+'</div>';
  if(!errors.length) msg+='<div class="ok">✅ <b>'+parsedRows.length+' teacher(s) ready.</b> No errors. Check preview below, then Upload.</div>';
  $('previewMsg').innerHTML=msg;
  let html='<table><tr><th>#</th><th>Name / Email</th><th>Subjects → Dept</th><th>Grades / Classes</th><th>Role / Password</th></tr>';
  parsedRows.slice(0,20).forEach(r=>{
    html+='<tr><td>'+r._line+'</td><td><b>'+esc(r.name)+'</b><br><span class="small">'+esc(r.email)+'<br>'+esc(r.phone||'—')+'</span></td><td><b>'+esc(r.subjectsStr)+'</b><br><span class="small">'+esc(r.departments.join(', '))+'</span></td><td>'+esc(r.gradesStr||'—')+'<br><span class="small">'+esc(r.classesStr||'—')+'</span></td><td><b>'+esc(r.role)+'</b><br><span class="small">Pass: '+esc(r.password)+'</span></td></tr>';
  });
  html+='</table><div class="small">Showing first 20 of '+parsedRows.length+'.</div>';
  $('previewTable').innerHTML=html;
  if(!errors.length && parsedRows.length){
    $('uploadCard').style.display='block';
    $('uploadSummary').innerHTML='👩🏾‍🏫 Ready to upload <b>'+parsedRows.length+' teacher(s)</b> to <b>'+esc(login.school)+'</b> (EMIS '+esc(login.emis)+')<br>• Teachers list + Login Users will both be created/updated.<br>• Default password if blank: <b>1234</b>';
    $('uploadCount').textContent=parsedRows.length+' Teachers';
    $('uploadMsg').innerHTML='';
  } else $('uploadCard').style.display='none';
};
window.uploadAll=async function(){
  if(!parsedRows.length){ $('uploadMsg').innerHTML='<div class="warn">No rows to upload. Preview first.</div>'; return; }
  const createUsers=$('createUsers').checked;
  if(!confirm('🚀 Upload '+parsedRows.length+' teachers to '+login.school+' (EMIS '+login.emis+')?'+(createUsers?' + Create login users.':''))) return;
  $('uploadMsg').innerHTML='<div class="info">⏳ Uploading... Do NOT close page.</div>';
  try{
    const base='EMIS_'+login.emis; let count=0;
    for(const r of parsedRows){
      const tid='TEACHER_'+login.emis+'_'+r.email.replace(/[^a-z0-9]/gi,'_');
      await setDoc(doc(db,'schools',base,'teachers',tid),{ name:r.name, email:r.email, phone:r.phone, subjects:r.subjects, subjectsStr:r.subjectsStr, departments:r.departments, grades:r.grades, classes:r.classes, role:r.role, createdAt:new Date().toISOString(), createdBy:login?.name||'', archived:false }, {merge:true});
      if(createUsers){
        const uid='USER_'+login.emis+'_'+r.email.replace(/[^a-z0-9]/gi,'_');
        await setDoc(doc(db,'schools',base,'users',uid),{ name:r.name, email:r.email, phone:r.phone, password:r.password, pin:r.password, role:r.role, subjects:r.subjects, grades:r.grades, createdAt:new Date().toISOString(), createdBy:login?.name||'', archived:false, blocked:false }, {merge:true});
      }
      count++; $('uploadProgress').innerHTML='<div class="info">⏳ '+count+' / '+parsedRows.length+' teachers uploaded...</div>';
    }
    await addDoc(collection(db,'auditLog'),{ when:new Date().toISOString(), who:login?.name||'', role:(login?.role||'').toUpperCase(), school:login?.school||'', emis:String(login?.emis||''), action:'TEACHERS_CSV_UPLOAD', details:'CSV uploaded '+parsedRows.length+' teachers' });
    $('uploadMsg').innerHTML='<div class="ok">✅ Uploaded <b>'+parsedRows.length+' teacher(s)</b> to '+esc(login.school)+'.<br>They can now login with email + password (default <b>1234</b> if you left password blank).<br><a href="teachers.html">Go to Teachers →</a> | <a href="profile.html">Go to Profile → Users →</a></div>';
    $('uploadProgress').innerHTML='';
  }catch(e){ $('uploadMsg').innerHTML='<div class="warn">❌ Upload failed: '+esc(e.message)+'<br>Some rows may have already uploaded. Check Teachers page, fix CSV, re-upload remaining rows only.</div>'; }
};
document.addEventListener('DOMContentLoaded', ()=>{
  login=getLogin();
  if(!login){ $('loginInfo').innerHTML='🔒 Not logged in. <a href="index.html">Login first</a>.'; $('blockedBox').style.display='block'; return; }
  const role=(login.role||'').toUpperCase();
  if(!['ADMIN','PRINCIPAL','LIBRARIAN','SUPER ADMIN'].includes(role)){
    $('loginInfo').innerHTML='🔒 <b>'+esc(login.name||'')+'</b> — Role <b>'+esc(role)+'</b> cannot upload teachers. Ask Admin.';
    $('blockedBox').style.display='block'; $('blockedBox').innerHTML='🔒 Teacher / Viewer cannot upload teachers. Ask Admin / Librarian.';
    return;
  }
  $('whoLine').textContent='Logged in: '+(login.name||'')+' • '+role+' • '+(login.school||'')+' (EMIS '+(login.emis||'')+')';
  $('loginInfo').innerHTML='✅ Logged in: <b>'+esc(login.name||'')+'</b> • '+role+' • '+(login.school||'')+' (EMIS '+(login.emis||'')+')';
  $('body').style.display='block';
});
</script>
</body>
</html>
