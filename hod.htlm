<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOD - Makhanani LTSM 2.0</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:#0a1f4d}
header{background:#0a1f4d;color:#fff;padding:14px 12px;text-align:center;border-bottom:4px solid #d4af37}
header h1{margin:0;font-size:20px}header p{margin:4px 0 0;font-size:12px;color:#d4af37}
.wrap{max-width:900px;margin:0 auto;padding:12px}.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
h2{margin:0 0 10px;font-size:16px}label{font-weight:900;font-size:13px;display:block;margin-top:12px}
input,select,textarea{width:100%;padding:14px;border:2px solid #0a1f4d;border-radius:8px;font-size:16px;font-weight:700;background:#fff;color:#0a1f4d}
.btn{border:none;border-radius:8px;padding:12px 12px;font-weight:900;cursor:pointer;font-size:13px}.btn-green{background:#0a1f4d;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}.btn-grey{background:#e2e8f0;color:#0a1f4d}.btn-red{background:#ef4444;color:#fff}.btn-teal{background:#0d9488;color:#fff}.btn-purple{background:#7c3aed;color:#fff}
.info{background:#fef3c7;border:2px solid #d4af37;border-radius:8px;padding:10px;font-size:13px;line-height:1.7;margin-top:10px}
.ok{background:#dcfce7;border:2px solid #22c55e;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.warn{background:#fee2e2;border:2px solid #ef4444;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.kpi{background:#fff;border-radius:12px;padding:16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.2)}.kpi b{font-size:28px;display:block}.kpi span{font-size:12px;color:#64748b}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px 8px;border-bottom:1px solid #e2e8f0;text-align:left}th{background:#0a1f4d;color:#fff}
@media(max-width:700px){.grid{grid-template-columns:1fr 1fr}.row{flex-direction:column}}
</style></head>
<body>
<header><h1>🎓 HOD DASHBOARD — MAKHANANI LTSM 2.0 — V2.22</h1><p>HOD ONLY — RANK 4 — APPROVE + MONITOR SUBJECTS — MY SCHOOL ONLY — WHATSAPP 078 023 3263</p>
<div id="taskbar"></div><script src="nav.js"></script>
</header>
<div class="wrap">
<div class="card"><h2>👤 Who Am I — HOD Only</h2>
<div class="info" id="whoAmI">Loading...</div>
<script>
try{
  var _u=null; try{_u=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
  if(_u && _u.email){
    var _role=String(_u.role||'').toUpperCase();
    document.getElementById('whoAmI').innerHTML='✅ <b>'+String(_u.name||'').toUpperCase()+'</b> — '+_role+' — RANK '+_u.rank+' — School: <b>'+String(_u.schoolName||'').toUpperCase()+'</b> — Subject: <b>'+String(_u.subject||'ALL').toUpperCase()+'</b> — Email: '+String(_u.email||'')+' — <span style="color:#16a34a">LOGGED IN ✅</span>';
    if(_role==='HOD' && _u.rank!=4){ document.getElementById('whoAmI').innerHTML+='<br><span style="color:#dc2626">⚠️ Your Rank is '+_u.rank+' — Should be 4 for HOD — Ask Super Admin to fix in Users.</span>'; }
    if(_role!=='HOD'){ document.getElementById('whoAmI').innerHTML+='<br><span style="color:#d97706">👀 VIEW-ONLY MODE — You are '+_role+' — Only a real HOD can Approve / Comment. Login as HOD to approve.</span>'; }
  } else { document.getElementById('whoAmI').innerHTML='❌ Not logged in — Go to login.html'; setTimeout(function(){ window.location.href='login.html'; },1500); }
}catch(e){ document.getElementById('whoAmI').innerHTML='Error: '+e.message; }
</script>
<div class="info" id="debugBox" style="background:#e0e7ff">🔍 DEBUG: Checking Firebase...</div>
<div class="row"><button class="btn btn-purple" onclick="go('manuals.html')">📖 OPEN MANUALS → HOD MANUAL</button></div>
<div class="row"><button class="btn btn-green" onclick="go('index.html')">🏠 HOME →</button><button class="btn btn-gold" onclick="go('subscriptions.html')">💰 SUBSCRIPTIONS →</button></div></div>

<div class="grid">
<div class="kpi"><b id="kpiTeachers">-</b><span>TEACHERS — MY SCHOOL</span></div>
<div class="kpi"><b id="kpiBooks">-</b><span>BOOKS — MY SUBJECT</span></div>
<div class="kpi"><b id="kpiIssued">-</b><span>ISSUED — MY SUBJECT</span></div>
<div class="kpi"><b id="kpiReturned">-</b><span>RETURNED</span></div>
<div class="kpi"><b id="kpiOut">-</b><span>STILL OUT</span></div>
<div class="kpi"><b id="kpiRetrieval" style="color:#f59e0b">-</b><span>RETRIEVAL % — MY SUBJECT</span></div>
</div>

<div class="card"><h2>♻️ Retrieval % — My Subject / School</h2>
<div class="info"><b>Formula:</b> Retrieval % = (Returned / Issued) x 100 — Target 100% — HOD sees their subject. Super Admin sees all.</div>
<div class="info" style="background:#e2e8f0;padding:4px;border-radius:8px"><div id="retrievalBar" style="background:#f59e0b;height:22px;border-radius:6px;width:0%;text-align:center;color:#fff;font-weight:900;font-size:12px;line-height:22px">Loading...</div></div>
<div id="retrievalMsg" class="info">Loading...</div></div>

<div class="card"><h2>✅ HOD Approval — Approve Teacher Request</h2>
<div class="info">HOD approves book requests / allocations for their subject. Pick an Issue / Request → Approve → Status becomes APPROVED. View-Only users cannot approve.</div>
<label>Pending Issue / Request To Approve *</label><select id="approveSelect"><option value="">-- Pick Pending To Approve --</option></select>
<label>HOD Comment (Optional)</label><textarea id="hodComment" rows="2" placeholder="e.g. Approved — Maths Grade 10 — 30 books"></textarea>
<div id="approveMsg"></div>
<div class="row"><button class="btn btn-green" onclick="approveItem()">✅ APPROVE →</button><button class="btn btn-red" onclick="rejectItem()">❌ REJECT</button></div></div>

<div class="card"><h2>👩‍🏫 Teachers — My School</h2><div style="overflow-x:auto"><table><thead><tr><th>Teacher</th><th>Subject</th><th>Class</th><th>Role / Rank</th></tr></thead><tbody id="teachersBody"><tr><td colspan="4">Loading...</td></tr></tbody></table></div></div>

<div class="card"><h2>📚 Issues — My Subject / School</h2><div style="overflow-x:auto"><table><thead><tr><th>Learner</th><th>Class</th><th>Book</th><th>Subject</th><th>Status</th><th>HOD</th></tr></thead><tbody id="issuesBody"><tr><td colspan="6">Loading...</td></tr></tbody></table></div></div>
<div class="card"><div class="row"><button class="btn btn-grey" onclick="navBack()">⬅️ BACK</button><button class="btn btn-green" onclick="go('index.html')">🏠 HOME →</button></div></div>
</div>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
function go(p){ window.location.href=p; }
function navBack(){ if(window.history.length>1) window.history.back(); else window.location.href='index.html'; }
var user=null; try{user=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
// V2.22 FIX — HOD + Super Admin + Admin + Principal can VIEW. Only HOD can Approve/Reject.
var _ROLE = String(user && user.role || '').toUpperCase();
if(!user || ['HOD','SUPER_ADMIN','ADMIN','PRINCIPAL'].indexOf(_ROLE)===-1){ alert('⛔ HOD only.'); window.location.href='login.html'; }
window._IS_VIEW_ONLY = (_ROLE !== 'HOD');
var rtdb=null, firebaseOK=false, users={}, books={}, issues={};
try{ if(typeof firebase!=='undefined'){ var cfg={apiKey:"AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA",authDomain:"makhanani-ltsm.firebaseapp.com",databaseURL:"https://makhanani-ltsm-default-rtdb.firebaseio.com",projectId:"makhanani-ltsm",storageBucket:"makhanani-ltsm.firebasestorage.app",messagingSenderId:"247180363183",appId:"1:247180363183:web:4e5a399d4e306192e01b5a",measurementId:"G-PEST1XFCR8"}; if(!firebase.apps.length) firebase.initializeApp(cfg); rtdb=firebase.database(); firebaseOK=true; } }catch(e){ firebaseOK=false; }
function setKPI(id,v){ var el=document.getElementById(id); if(el) el.textContent=v; }
function isMine(i){
  if(_ROLE==='SUPER_ADMIN') return true;
  // HOD sees own subject, or all if no subject set
  if(!user.subject) return true;
  return String(i.subject||'').toUpperCase()===String(user.subject||'').toUpperCase() || String(i.subject||'')==='';
}
function render(){
  var teachers = Object.values(users).filter(function(u){ return String(u.role||'').toUpperCase()==='TEACHER'; });
  var issuesArr = Object.values(issues).filter(isMine);
  var issued = issuesArr.length;
  var returned = issuesArr.filter(function(i){ return String(i.status||'').toUpperCase()==='RETURNED'; }).length;
  var ret = issued>0?Math.round(returned/issued*100):100;
  var myBooks = Object.values(books).filter(function(b){ if(_ROLE==='SUPER_ADMIN'||!user.subject) return true; return String(b.subject||'').toUpperCase()===String(user.subject||'').toUpperCase(); });
  setKPI('kpiTeachers', teachers.length); setKPI('kpiBooks', myBooks.length); setKPI('kpiIssued', issued); setKPI('kpiReturned', returned); setKPI('kpiOut', issued-returned); setKPI('kpiRetrieval', ret+'%');
  var bar=document.getElementById('retrievalBar'); bar.style.width=ret+'%'; bar.textContent=ret+'% — Retrieval'; bar.style.background=ret>=95?'#22c55e':ret>=85?'#f59e0b':'#ef4444';
  document.getElementById('retrievalMsg').innerHTML='✅ Issued <b>'+issued+'</b> — Returned <b>'+returned+'</b> — Still Out <b>'+(issued-returned)+'</b> — Retrieval % <b>'+ret+'%</b>';
  // Approve select — Issues not yet approved
  var sel=document.getElementById('approveSelect'); var cur=sel.value; sel.innerHTML='<option value="">-- Pick Pending To Approve --</option>';
  Object.keys(issues).forEach(function(k){ var i=issues[k]; i._id=k; if(!i.hodApproved && isMine(i)){ var o=document.createElement('option'); o.value=k; o.textContent=String(i.learnerName||'').toUpperCase()+' — '+String(i.bookTitle||'').toUpperCase()+' — '+(i.className||''); sel.appendChild(o); } });
  sel.value=cur;
  document.getElementById('teachersBody').innerHTML=teachers.length?teachers.map(function(t){ return '<tr><td><b>'+String(t.name||'').toUpperCase()+'</b></td><td>'+String(t.subject||'-').toUpperCase()+'</td><td>'+String(t.className||'-').toUpperCase()+'</td><td>'+String(t.role||'').toUpperCase()+' — RANK '+(t.rank||'')+'</td></tr>'; }).join(''):'<tr><td colspan="4">No teachers yet — Create in Users.</td></tr>';
  document.getElementById('issuesBody').innerHTML=issuesArr.length?issuesArr.slice().reverse().map(function(i){ return '<tr><td>'+String(i.learnerName||'').toUpperCase()+'</td><td>'+String(i.className||'').toUpperCase()+'</td><td>'+String(i.bookTitle||'').toUpperCase()+'</td><td>'+String(i.subject||'-').toUpperCase()+'</td><td>'+String(i.status||'').toUpperCase()+'</td><td>'+(i.hodApproved?'✅ APPROVED BY '+String(i.hodBy||'').toUpperCase():'⏳ PENDING')+'</td></tr>'; }).join(''):'<tr><td colspan="6">No issues yet.</td></tr>';
  document.getElementById('debugBox').innerHTML='🔍 DEBUG: ✅ Firebase Live Data Loaded ✅';
}
async function approveItem(){
  var msg=document.getElementById('approveMsg');
  if(window._IS_VIEW_ONLY){ msg.innerHTML='<div class="warn">⛔ View-Only — Login as HOD to Approve.</div>'; return; }
  var id=document.getElementById('approveSelect').value; var comment=document.getElementById('hodComment').value.trim();
  if(!id){ msg.innerHTML='<div class="warn">❌ Pick a Pending Issue to Approve.</div>'; return; }
  try{ await rtdb.ref('issues/'+id).update({hodApproved:true,hodBy:user.email,hodComment:comment,hodApprovedAt:Date.now()}); msg.innerHTML='<div class="ok">✅ Approved by HOD.</div>'; document.getElementById('hodComment').value=''; }catch(e){ msg.innerHTML='<div class="warn">❌ Approve failed: '+e.message+'</div>'; }
}
async function rejectItem(){
  var msg=document.getElementById('approveMsg');
  if(window._IS_VIEW_ONLY){ msg.innerHTML='<div class="warn">⛔ View-Only — Login as HOD to Reject.</div>'; return; }
  var id=document.getElementById('approveSelect').value; var comment=document.getElementById('hodComment').value.trim();
  if(!id){ msg.innerHTML='<div class="warn">❌ Pick a Pending Issue to Reject.</div>'; return; }
  if(!confirm('Reject this issue?')) return;
  try{ await rtdb.ref('issues/'+id).update({hodApproved:false,hodRejected:true,hodBy:user.email,hodComment:comment,hodApprovedAt:Date.now()}); msg.innerHTML='<div class="ok">✅ Rejected by HOD.</div>'; }catch(e){ msg.innerHTML='<div class="warn">❌ Reject failed: '+e.message+'</div>'; }
}
if(!firebaseOK){ document.getElementById('debugBox').innerHTML='🔍 DEBUG: ✅ Logged in — ❌ Firebase BLOCKED — Turn OFF WiFi, use Phone Data, reload.'; }
else {
  document.getElementById('debugBox').innerHTML='🔍 DEBUG: ✅ Firebase Loaded — Loading...';
  rtdb.ref('users').on('value', function(s){ users=s.val()||{}; render(); });
  rtdb.ref('books').on('value', function(s){ books=s.val()||{}; render(); });
  rtdb.ref('issues').on('value', function(s){ issues=s.val()||{}; render(); });
}
</script></body></html>
