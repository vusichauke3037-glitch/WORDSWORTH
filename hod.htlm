<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOD - Makhanani LTSM 2.0</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:#0a1f4d}
header{background:#0a1f4d;color:#fff;padding:14px 12px;text-align:center;border-bottom:4px solid #d4af37}
header h1{margin:0;font-size:20px}header p{margin:4px 0 0;font-size:12px;color:#d4af37}
.wrap{max-width:1200px;margin:0 auto;padding:12px}
.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
h2{margin:0 0 10px;font-size:16px}label{font-weight:900;font-size:13px;display:block;margin-top:12px}
input,select{width:100%;padding:14px;border:2px solid #0a1f4d;border-radius:8px;font-size:16px;font-weight:700;background:#fff;color:#0a1f4d;cursor:pointer;text-transform:uppercase}
input{cursor:text}
select:focus,input:focus{border-color:#d4af37;outline:none;background:#fef3c7}
.btn{border:none;border-radius:8px;padding:10px 12px;font-weight:900;cursor:pointer;font-size:13px}
.btn-full{width:100%;margin-top:12px}.btn-green{background:#0a1f4d;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}.btn-grey{background:#e2e8f0;color:#0a1f4d}.btn-red{background:#ef4444;color:#fff}.btn-teal{background:#0d9488;color:#fff}
.info{background:#fef3c7;border:2px solid #d4af37;border-radius:8px;padding:10px;font-size:13px;line-height:1.6;margin-top:10px}
.warn{background:#fee2e2;border:2px solid #ef4444;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.ok{background:#dcfce7;border:2px solid #22c55e;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}
.kpi div{background:#fff;border-radius:12px;padding:14px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.2);cursor:pointer}
.kpi b{font-size:20px;display:block}.kpi span{font-size:11px;font-weight:900;color:#64748b}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:10px 8px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:middle}th{background:#0a1f4d;color:#fff}
.badge{display:inline-block;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:900}.badge-pending{background:#fef3c7;color:#92400e}.badge-approved{background:#dcfce7;color:#166534}.badge-rejected{background:#fee2e2;color:#991b1b}.badge-issued{background:#dbeafe;color:#1e40af}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tabs button{flex:1;min-width:110px;padding:12px;border:none;border-radius:8px;background:#e2e8f0;font-weight:900;cursor:pointer}.tabs button.active{background:#0a1f4d;color:#fff}
.tab{display:none}.tab.active{display:block}
.rule{background:#0a1f4d;color:#fff;border-radius:10px;padding:12px;font-size:13px;line-height:1.7;margin-top:10px}.rule b{color:#d4af37}
@media(max-width:700px){.kpi{grid-template-columns:repeat(2,1fr)}.row{flex-direction:column}table{font-size:12px}}
</style></head>
<body>
<header><h1>👔 HOD — MAKHANANI LTSM 2.0</h1><p>RANK 3/5 • APPROVE / REJECT MY SUBJECT REQUESTS ONLY • APPROVAL UNLOCKS LIBRARIAN ISSUE</p>
<div id="taskbar"></div><script src="nav.js"></script>
<script>guardPage(3,'HOD');</script>
</header>
<div class="wrap">
<div class="info" id="roleInfo">Loading...</div>
<div class="kpi"><div onclick="showTab('requests')"><b id="kpiPending">0</b><span>⏳ PENDING — MY SUBJECT</span></div><div onclick="showTab('requests')"><b id="kpiApproved">0</b><span>✅ APPROVED BY ME / HOD</span></div><div onclick="showTab('requests')"><b id="kpiRejected">0</b><span>❌ REJECTED</span></div><div onclick="showTab('teachers')"><b id="kpiTeachers">0</b><span>👩‍🏫 MY SUBJECT TEACHERS</span></div></div>
<div class="tabs"><button id="tabBtnRequests" class="active" onclick="showTab('requests')">🧾 Approve Requests — My Subject</button><button id="tabBtnTeachers" onclick="showTab('teachers')">👩‍🏫 My Subject Teachers</button><button id="tabBtnStock" onclick="showTab('stock')">📖 My Subject Stock</button></div>
<div id="tab-requests" class="tab active"><div class="card"><h2>🧾 Approve / Reject — My Subject Only</h2><div class="rule">📌 <b>HOD RULE:</b> You approve <b>ONLY your subject</b> requests.<br>• MATHS HOD approves MATHS requests — NOT English / History<br>• ✅ APPROVE → Librarian can now issue to that teacher<br>• ❌ REJECT → Librarian CANNOT issue — Teacher must make NEW request<br>• You CANNOT issue books — Only Librarian issues after you approve</div><div class="row"><div><label>🔍 Search</label><input id="reqSearch" placeholder="🔍 Teacher / Item / Class" oninput="renderRequests()"></div><div><label>📖 Filter</label><select id="reqStatus" onchange="renderRequests()"><option value="">📖 ALL MY SUBJECT</option><option value="PENDING">⏳ PENDING</option><option value="APPROVED">✅ APPROVED</option><option value="REJECTED">❌ REJECTED</option><option value="ISSUED">📤 ISSUED BY LIBRARIAN</option></select></div></div><div id="requestsInfo" class="info">Loading...</div><div style="overflow-x:auto;margin-top:12px"><table><thead><tr><th>Date</th><th>Teacher</th><th>Class / Subject</th><th>Item</th><th>Qty</th><th>Status</th><th>Approved / Rejected By</th><th>Action</th></tr></thead><tbody id="requestsTable"></tbody></table></div><div class="info">Other subjects' requests are hidden from HOD — Principal sees ALL.</div></div></div>
<div id="tab-teachers" class="tab"><div class="card"><h2>👩‍🏫 My Subject Teachers</h2><div id="teachersInfo" class="info">Loading...</div><div id="teachersList"></div></div></div>
<div id="tab-stock" class="tab"><div class="card"><h2>📖 My Subject Stock — View Only</h2><div id="stockInfo" class="info">Loading...</div><div id="stockList"></div><button class="btn btn-gold btn-full" onclick="location.href='stock.html'">📦 OPEN FULL STOCK PAGE →</button></div></div>
</div>
<script>
const firebaseConfig={apiKey:"AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA",authDomain:"makhanani-ltsm.firebaseapp.com",databaseURL:"https://makhanani-ltsm-default-rtdb.firebaseio.com",projectId:"makhanani-ltsm",storageBucket:"makhanani-ltsm.firebasestorage.app",messagingSenderId:"247180363183",appId:"1:247180363183:web:4e5a399d4e306192e01b5a",measurementId:"G-PEST1XFCR8"};
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const rtdb=firebase.database();
function toCaps(s){return String(s||'').trim().toUpperCase();}
function fmtDate(ts){if(!ts) return '—';return new Date(ts).toLocaleDateString('en-ZA',{day:'numeric',month:'short',year:'numeric'});}
function normSubject(s){ let x=String(s||'').toUpperCase().replace(/[^A-Z ]/g,' ').replace(/\s+/g,' ').trim(); if(x.includes('MATH')) return 'MATHEMATICS'; if(x.startsWith('ENGLISH')) return 'ENGLISH'; if(x.includes('PHYSICAL')) return 'PHYSICAL SCIENCES'; if(x.includes('LIFE SCI')) return 'LIFE SCIENCES'; if(x.includes('ACCOUNT')) return 'ACCOUNTING'; if(x.includes('BUSINESS')) return 'BUSINESS STUDIES'; if(x.includes('HISTORY')) return 'HISTORY'; if(x.includes('GEOGRAPH')) return 'GEOGRAPHY'; return x; }
function avail(b){ return Math.max(0,parseInt(b.total||0)-parseInt(b.out||0)-parseInt(b.lost||0)); }
let user=null;try{user=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
let myName=user?.name||'HOD MATHS';
let myEmail=(user?.email||'hod.maths@wordsworth.co.za').toLowerCase();
let mySchoolId=user?.schoolId||'WHS';
let mySchoolName=user?.schoolName||mySchoolId;
let mySubject=user?.subject||'MATHEMATICS';
let mySubjectNorm=normSubject(mySubject);
let stock=[], orders=[], usersList=[];
function showTab(t){document.querySelectorAll('.tab').forEach(el=>el.classList.remove('active'));document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));document.getElementById('tab-'+t).classList.add('active');document.getElementById('tabBtn'+t.charAt(0).toUpperCase()+t.slice(1)).classList.add('active');}
function demoData(){
  usersList=[
    {id:'u6',name:'MRS DUBE',email:'dube@wordsworth.co.za',role:'Teacher',subject:'MATHEMATICS',teachingClasses:['10A','10B','11A']},
    {id:'u9',name:'MR MOYO',email:'moyo@wordsworth.co.za',role:'Teacher',subject:'MATHEMATICS',teachingClasses:['11A','12A']},
    {id:'u7',name:'MR SMITH',email:'smith@wordsworth.co.za',role:'Teacher',subject:'ENGLISH',teachingClasses:['10A']},
  ];
  stock=[
    {id:'S1',grade:'10',subject:'MATHEMATICS',title:'MATHEMATICS GRADE 10 TEXTBOOK',total:25,out:3,lost:0,schoolId:mySchoolId},
    {id:'S6',grade:'11',subject:'MATHEMATICS',title:'MATHEMATICS GRADE 11 TEXTBOOK',total:15,out:0,lost:0,schoolId:mySchoolId},
    {id:'S3',grade:'10',subject:'ENGLISH',title:'ENGLISH GRADE 10 TEXTBOOK',total:18,out:2,lost:0,schoolId:mySchoolId},
  ];
  orders=[
    {id:'o1',item:'MATHEMATICS GRADE 10 TEXTBOOK',class:'10A',qty:5,subject:'MATHEMATICS',status:'PENDING',requestedBy:'MRS DUBE',teacherEmail:'dube@wordsworth.co.za',schoolId:mySchoolId,createdAt:Date.now()-86400000},
    {id:'o2',item:'MATHEMATICS GRADE 11 TEXTBOOK',class:'11A',qty:4,subject:'MATHEMATICS',status:'PENDING',requestedBy:'MR MOYO',teacherEmail:'moyo@wordsworth.co.za',schoolId:mySchoolId,createdAt:Date.now()-3600000},
    {id:'o3',item:'ENGLISH GRADE 10 TEXTBOOK',class:'10A',qty:3,subject:'ENGLISH',status:'PENDING',requestedBy:'MR SMITH',teacherEmail:'smith@wordsworth.co.za',schoolId:mySchoolId,createdAt:Date.now()-3600000},
    {id:'o4',item:'MATHEMATICS GRADE 10 TEXTBOOK',class:'10B',qty:2,subject:'MATHEMATICS',status:'APPROVED',requestedBy:'MRS DUBE',teacherEmail:'dube@wordsworth.co.za',approvedBy:'HOD MATHS',approvedAt:Date.now()-3600000,schoolId:mySchoolId,createdAt:Date.now()-172800000},
  ];
  renderAll('Demo data — Loading real data...');
}
function myOrders(){ return orders.filter(o=> normSubject(o.subject||o.item||'')===mySubjectNorm || normSubject(o.subject||'')===mySubjectNorm); }
function renderAll(note){
  document.getElementById('roleInfo').innerHTML=`👔 <b>${toCaps(myName)}</b> — Role: <b>HOD — RANK 3/5</b> — Subject: <b>${toCaps(mySubjectNorm)}</b> — School: <b>${toCaps(mySchoolName)} (${mySchoolId})</b><br>You approve <b>ONLY ${toCaps(mySubjectNorm)}</b> requests. Other subjects are hidden. ${note?'<br><small>'+note+'</small>':''}`;
  let mine=myOrders();
  document.getElementById('kpiPending').textContent=mine.filter(o=>String(o.status||'').toUpperCase()==='PENDING').length;
  document.getElementById('kpiApproved').textContent=mine.filter(o=>['APPROVED','ISSUED'].includes(String(o.status||'').toUpperCase())).length;
  document.getElementById('kpiRejected').textContent=mine.filter(o=>String(o.status||'').toUpperCase()==='REJECTED').length;
  let myTeachers=usersList.filter(u=>u.role==='Teacher' && normSubject(u.subject)===mySubjectNorm);
  document.getElementById('kpiTeachers').textContent=myTeachers.length;
  document.getElementById('teachersInfo').innerHTML=`<b>${myTeachers.length}</b> teacher(s) in <b>${toCaps(mySubjectNorm)}</b> in ${mySchoolId}`;
  document.getElementById('teachersList').innerHTML=myTeachers.length?myTeachers.map(t=>{ let tOrders=mine.filter(o=>String(o.teacherEmail||'').toLowerCase()===(t.email||'').toLowerCase()); return `<div class="info"><b>👩‍🏫 ${toCaps(t.name)}</b> — ${toCaps(t.subject)} — Classes ${(t.teachingClasses||[]).join(', ')}<br>Requests: PENDING <b>${tOrders.filter(o=>String(o.status)==='PENDING').length}</b> — Approved <b>${tOrders.filter(o=>['APPROVED','ISSUED'].includes(String(o.status))).length}</b> — Rejected <b>${tOrders.filter(o=>String(o.status)==='REJECTED').length}</b></div>`; }).join(''):'No teachers in your subject.';
  let myStock=stock.filter(b=>normSubject(b.subject)===mySubjectNorm);
  document.getElementById('stockInfo').innerHTML=`<b>${myStock.length}</b> titles in ${toCaps(mySubjectNorm)} — Avail <b>${myStock.reduce((s,b)=>s+avail(b),0)}</b>`;
  document.getElementById('stockList').innerHTML=myStock.map(b=>`<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eee"><span><b>${toCaps(b.title)}</b> — Grade ${b.grade}</span><b>Avail ${avail(b)} / Total ${b.total}</b></div>`).join('');
  renderRequests();
}
function renderRequests(){
  let q=document.getElementById('reqSearch').value.trim().toUpperCase();
  let f=document.getElementById('reqStatus').value;
  let list=myOrders().filter(o=>{ if(f && String(o.status||'').toUpperCase()!==f) return false; if(q && !(toCaps(o.requestedBy)+' '+toCaps(o.item)+' '+toCaps(o.class)).toUpperCase().includes(q)) return false; return true; });
  document.getElementById('requestsInfo').innerHTML=`Showing <b>${list.length}</b> of <b>${myOrders().length}</b> ${toCaps(mySubjectNorm)} requests — PENDING <b>${myOrders().filter(o=>String(o.status)==='PENDING').length}</b> — Other subjects hidden from HOD.`;
  document.getElementById('requestsTable').innerHTML=list.length?list.slice().reverse().map(o=>{
    let st=String(o.status||'PENDING').toUpperCase();
    let badge=st==='PENDING'?'badge-pending':st==='APPROVED'?'badge-approved':st==='REJECTED'?'badge-rejected':'badge-issued';
    return `<tr><td>${fmtDate(o.createdAt)}</td><td><b>${toCaps(o.requestedBy||'')}</b></td><td><b>${o.class}</b> — ${toCaps(o.subject||'')}</td><td><b>${toCaps(o.item||'')}</b></td><td><b>${o.qty}</b></td><td><span class="badge ${badge}">${st}</span></td><td>${toCaps(o.approvedBy||o.rejectedBy|| (st==='PENDING'?'— Waiting You —':'—'))}<br><small>${o.approvedAt||o.rejectedAt?fmtDate(o.approvedAt||o.rejectedAt):''}</small></td><td>${st==='PENDING'?`<button class="btn btn-green" onclick="approveOrder('${o.id}')">✅ APPROVE</button> <button class="btn btn-red" onclick="rejectOrder('${o.id}')">❌ REJECT</button>`: st==='APPROVED'?`<small>✅ Approved — Librarian can now issue</small>`: st==='REJECTED'?`<button class="btn btn-grey" onclick="unrejectOrder('${o.id}')">↩️ UN-REJECT → PENDING</button>`:`<small>📤 Issued by Librarian</small>`}</td></tr>`;
  }).join(''):`<tr><td colspan="8" style="text-align:center;padding:20px">No ${toCaps(mySubjectNorm)} requests for this filter.</td></tr>`;
}
async function approveOrder(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  if(normSubject(o.subject||o.item||'')!==mySubjectNorm){ alert('⛔ You can only approve '+mySubjectNorm+' requests. This is '+normSubject(o.subject||'')+'.'); return; }
  if(String(o.status||'').toUpperCase()!=='PENDING'){ alert('This request is '+o.status+', not PENDING.'); return; }
  if(!confirm(`✅ APPROVE: ${o.qty} x ${o.item} for ${o.requestedBy} — Class ${o.class}?\n\nLibrarian will then be able to issue it to the teacher.`)) return;
  o.status='APPROVED'; o.approvedBy=myName; o.approvedAt=Date.now(); o.rejectedBy=''; o.rejectedAt=null;
  try{await rtdb.ref('orders/'+id).update({status:'APPROVED',approvedBy:myName,approvedAt:Date.now(),rejectedBy:null});}catch(e){}
  renderAll('✅ Approved — Librarian can now issue ✅');
}
async function rejectOrder(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  if(normSubject(o.subject||o.item||'')!==mySubjectNorm){ alert('⛔ You can only reject '+mySubjectNorm+' requests.'); return; }
  let reason=prompt(`❌ REJECT: ${o.qty} x ${o.item} for ${o.requestedBy} — Class ${o.class}?\n\nType reason (optional):`, 'NOT ENOUGH STOCK / WRONG GRADE / DUPLICATE REQUEST');
  if(reason===null) return;
  o.status='REJECTED'; o.rejectedBy=myName; o.rejectedAt=Date.now(); o.rejectReason=reason; o.approvedBy='';
  try{await rtdb.ref('orders/'+id).update({status:'REJECTED',rejectedBy:myName,rejectedAt:Date.now(),rejectReason:reason,approvedBy:null});}catch(e){}
  renderAll('❌ Rejected — Librarian CANNOT issue this request');
}
async function unrejectOrder(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  if(!confirm('Put this REJECTED request back to PENDING?')) return;
  o.status='PENDING'; o.rejectedBy=''; o.rejectedAt=null;
  try{await rtdb.ref('orders/'+id).update({status:'PENDING',rejectedBy:null,rejectedAt:null});}catch(e){}
  renderAll('↩️ Back to PENDING');
}
async function loadData(){
  demoData();
  try{
    let [b,o,u]=await Promise.all([rtdb.ref('books').once('value'), rtdb.ref('orders').once('value'), rtdb.ref('users/'+mySchoolId).once('value')]);
    let fbBooks=Object.entries(b.val()||{}).map(([id,v])=>({id,...v}));
    let mineBooks=fbBooks.filter(x=>!x.schoolId||x.schoolId===mySchoolId);
    if(fbBooks.length>0 && mineBooks.length>0) stock=mineBooks.map(x=>({id:x.id,grade:String(x.grade||''),subject:x.subject||'',title:x.title||'',total:parseInt(x.total||0),out:parseInt(x.out||0),lost:parseInt(x.lost||0),schoolId:x.schoolId||mySchoolId}));
    let fbOrders=Object.entries(o.val()||{}).map(([id,v])=>({id,...v}));
    let mineOrders=fbOrders.filter(x=>!x.schoolId||x.schoolId===mySchoolId);
    if(fbOrders.length>0 && mineOrders.length>0) orders=mineOrders;
    let fbUsers=Object.entries(u.val()||{}).map(([id,v])=>({id,...v}));
    if(fbUsers.length>0) usersList=fbUsers;
    renderAll('Real data loaded from Firebase ✅');
  }catch(e){ renderAll('Showing demo data — Firebase not reachable / empty.'); }
}
loadData();
</script></body></html>
