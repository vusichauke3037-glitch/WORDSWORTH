<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOD - Makhanani LTSM 2.0</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:#0a1f4d}
header{background:#0a1f4d;color:#fff;padding:14px 12px;text-align:center;border-bottom:4px solid #d4af37}
header h1{margin:0;font-size:20px}header p{margin:4px 0 0;font-size:12px;color:#d4af37}
.wrap{max-width:1000px;margin:0 auto;padding:12px}.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
h2{margin:0 0 10px;font-size:16px}label{font-weight:900;font-size:13px;display:block;margin-top:12px}
input,select{width:100%;padding:14px;border:2px solid #0a1f4d;border-radius:8px;font-size:16px;font-weight:700;background:#fff;color:#0a1f4d;cursor:pointer}
input{cursor:text}.btn{border:none;border-radius:8px;padding:10px 12px;font-weight:900;cursor:pointer;font-size:13px}.btn-green{background:#0a1f4d;color:#fff}.btn-red{background:#ef4444;color:#fff}.btn-teal{background:#0d9488;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}
.info{background:#fef3c7;border:2px solid #d4af37;border-radius:8px;padding:10px;font-size:13px;line-height:1.6;margin-top:10px}.warn{background:#fee2e2;border:2px solid #ef4444;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}.ok{background:#dcfce7;border:2px solid #22c55e;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}.kpi div{background:#fff;border-radius:12px;padding:14px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.2)}.kpi b{font-size:20px;display:block}.kpi span{font-size:11px;font-weight:900;color:#64748b}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:10px 8px;border-bottom:1px solid #e2e8f0;text-align:left}th{background:#0a1f4d;color:#fff}
@media(max-width:700px){.kpi{grid-template-columns:repeat(2,1fr)}.row{flex-direction:column}}
</style></head>
<body>
<header><h1>👔 HOD — MAKHANANI LTSM 2.0</h1><p>APPROVE ORDERS — MY HOD SUBJECTS ONLY — ALL CAPS — INTERMEDIATE (4-6) TO FET (10-12) — CLASSES A TO J — 4A TO 12J</p>
<div id="taskbar"></div><script src="nav.js"></script>
<script>guardPage(3,'HOD');</script>
</header>
<div class="wrap">
<div class="info" id="roleInfo">Loading...</div>
<div class="kpi"><div><b id="kpiPending">0</b><span>⏳ PENDING MY APPROVAL</span></div><div><b id="kpiApproved">0</b><span>✅ APPROVED</span></div><div><b id="kpiRejected">0</b><span>❌ REJECTED</span></div><div><b id="kpiTotal">0</b><span>📚 TOTAL SEEN</span></div></div>
<div class="card"><h2>⏳ Pending Orders — My HOD Subjects Only — Classes A To J</h2>
<div class="info" id="hodInfo">Loading HOD subjects...</div>
<div class="row"><div><label>🔍 Search</label><input id="searchOrders" placeholder="🔍 Learner / Book / Teacher" oninput="renderOrders()"></div><div><label>📚 Filter Subject — ALL CAPS — My Subjects</label><select id="filterSubject" onchange="renderOrders()"><option value="">📚 ALL MY HOD SUBJECTS</option></select></div><div><label>🎓 Filter Grade — 4 To 12</label><select id="filterGrade" onchange="renderOrders()"><option value="">🎓 ALL GRADES — 4 TO 12</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option><option>11</option><option>12</option></select></div><div><label>🏫 Filter Class — A To J</label><select id="filterClass" onchange="renderOrders()"><option value="">🏫 ALL CLASSES — 4A TO 12J — 90 CLASSES</option></select></div><div><label>📊 Filter Status</label><select id="filterStatus" onchange="renderOrders()"><option value="">📊 ALL</option><option>PENDING HOD</option><option>APPROVED</option><option>REJECTED</option></select></div></div>
<div id="ordersInfo" class="info">Loading...</div>
<div style="overflow-x:auto;margin-top:12px"><table><thead><tr><th>Learner / Class / Grade</th><th>Book — ALL CAPS</th><th>Subject / Grade</th><th>Teacher</th><th>Status</th><th>Action</th></tr></thead><tbody id="ordersTable"></tbody></table></div>
<div class="row"><button class="btn btn-green" onclick="approveAllVisible()">✅ APPROVE ALL VISIBLE PENDING</button><button class="btn btn-red" onclick="rejectAllVisible()">❌ REJECT ALL VISIBLE PENDING</button></div>
<div id="hodMsg"></div></div>
</div>
<script>
const firebaseConfig={apiKey:"AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA",authDomain:"makhanani-ltsm.firebaseapp.com",databaseURL:"https://makhanani-ltsm-default-rtdb.firebaseio.com",projectId:"makhanani-ltsm",storageBucket:"makhanani-ltsm.firebasestorage.app",messagingSenderId:"247180363183",appId:"1:247180363183:web:4e5a399d4e306192e01b5a",measurementId:"G-PEST1XFCR8"};
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const rtdb=firebase.database();
function toCaps(s){return String(s||'').trim().toUpperCase();}
function norm(s){return String(s||'').trim().toUpperCase().replace(/[^A-Z0-9]/g,'');}
function arr(v){if(Array.isArray(v)) return v.map(toCaps).filter(Boolean); if(v) return [toCaps(v)]; return [];}
let user=null;try{user=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
let mySchoolId=user?.schoolId||'WHS';
let myHodSubjects=arr(user?.hodSubjects).length?arr(user?.hodSubjects):(arr(user?.subjects).length?arr(user?.subjects):arr(user?.subject));
const SUBJECT_GROUPS=[
  {label:'INTERMEDIATE — GRADES 4-6', items:['ENGLISH HOME LANGUAGE','ENGLISH FIRST ADDITIONAL LANGUAGE','AFRIKAANS HOME LANGUAGE','AFRIKAANS FIRST ADDITIONAL LANGUAGE','ISIZULU HOME LANGUAGE','ISIXHOSA HOME LANGUAGE','SESOTHO HOME LANGUAGE','SETSWANA HOME LANGUAGE','MATHEMATICS','NATURAL SCIENCES AND TECHNOLOGY','SOCIAL SCIENCES','LIFE SKILLS']},
  {label:'SENIOR — GRADES 7-9', items:['NATURAL SCIENCES','ECONOMIC AND MANAGEMENT SCIENCES','TECHNOLOGY','CREATIVE ARTS','LIFE ORIENTATION']},
  {label:'FET — GRADES 10-12', items:['MATHEMATICAL LITERACY','TECHNICAL MATHEMATICS','PHYSICAL SCIENCES','TECHNICAL SCIENCES','LIFE SCIENCES','AGRICULTURAL SCIENCES','ACCOUNTING','BUSINESS STUDIES','ECONOMICS','HISTORY','GEOGRAPHY','TOURISM','CONSUMER STUDIES','COMPUTER APPLICATIONS TECHNOLOGY','INFORMATION TECHNOLOGY','ENGINEERING GRAPHICS AND DESIGN','VISUAL ARTS','DRAMATIC ARTS','MUSIC','PHYSICAL EDUCATION','RELIGION STUDIES']}
];
const ALL_SUBJECTS=[...new Set(SUBJECT_GROUPS.flatMap(g=>g.items))];
// --- CLASSES A TO J — 90 CLASSES — SAME AS users V2.11 + teacher V2.13 + librarian V2.11 ---
const ALL_CLASSES=['4A','4B','4C','4D','4E','4F','4G','4H','4I','4J','5A','5B','5C','5D','5E','5F','5G','5H','5I','5J','6A','6B','6C','6D','6E','6F','6G','6H','6I','6J','7A','7B','7C','7D','7E','7F','7G','7H','7I','7J','8A','8B','8C','8D','8E','8F','8G','8H','8I','8J','9A','9B','9C','9D','9E','9F','9G','9H','9I','9J','10A','10B','10C','10D','10E','10F','10G','10H','10I','10J','11A','11B','11C','11D','11E','11F','11G','11H','11I','11J','12A','12B','12C','12D','12E','12F','12G','12H','12I','12J'];
let orders=[];
function demoOrders(){
  return [
    {barcode:'WHS000001',learnerName:'LEARNER 4J-1',learnerId:'4J001',className:'4J',grade:'4',title:'ENGLISH HOME LANGUAGE GRADE 4',subject:'ENGLISH HOME LANGUAGE',teacher:'MRS MOKOENA',date:'2026-11-17',status:'PENDING HOD'},
    {barcode:'WHS000011',learnerName:'LEARNER 6J-1',learnerId:'6J001',className:'6J',grade:'6',title:'NATURAL SCIENCES AND TECHNOLOGY GRADE 6',subject:'NATURAL SCIENCES AND TECHNOLOGY',teacher:'MR DLAMINI',date:'2026-11-17',status:'PENDING HOD'},
    {barcode:'WHS000021',learnerName:'LEARNER 10J-1',learnerId:'10J001',className:'10J',grade:'10',title:'MATHEMATICS GRADE 10',subject:'MATHEMATICS',teacher:'MRS DUBE',date:'2026-11-17',status:'PENDING HOD'},
    {barcode:'WHS000031',learnerName:'LEARNER 12J-1',learnerId:'12J001',className:'12J',grade:'12',title:'HISTORY GRADE 12',subject:'HISTORY',teacher:'MS JONES',date:'2026-11-17',status:'PENDING HOD'},
    {barcode:'WHS000041',learnerName:'LEARNER 11J-1',learnerId:'11J001',className:'11J',grade:'11',title:'ACCOUNTING GRADE 11',subject:'ACCOUNTING',teacher:'MRS DUBE',date:'2026-11-17',status:'PENDING HOD'},
  ];
}
function loadAll(){
  document.getElementById('roleInfo').innerHTML=`👔 <b>${toCaps(user?.name||'HOD')}</b> — HOD — RANK 3 — School: <b>${mySchoolId}</b><br>HOD Subjects (ALL CAPS): <b>${myHodSubjects.join(', ')||'ALL'}</b><br>Teaches: <b>${arr(user?.subjects).join(', ')||'—'}</b><br>Classes: <b>4A to 12J — A to J — 90 classes</b> — You filter by any class, approve by subject.`;
  document.getElementById('hodInfo').innerHTML=`You approve ONLY: <b>${myHodSubjects.join(', ')||'ALL'}</b><br>Orders for other subjects are HIDDEN from you — They go to their own HOD. Example: HOD with NATURAL SCIENCES AND TECHNOLOGY sees Grade 6 orders, NOT NATURAL SCIENCES Grade 8 orders.<br>Classes: <b>4A to 12J</b> — Use Filter Class to see only 4J, 10J, 12J, etc.`;
  let sHtml='<option value="">📚 ALL MY HOD SUBJECTS</option>';
  SUBJECT_GROUPS.forEach(g=>{ let mine=g.items.filter(s=>myHodSubjects.includes(s)); if(mine.length) sHtml+=`<optgroup label="${g.label}">${mine.map(s=>`<option>${s}</option>`).join('')}</optgroup>`; });
  document.getElementById('filterSubject').innerHTML=sHtml;
  document.getElementById('filterClass').innerHTML='<option value="">🏫 ALL CLASSES — 4A TO 12J — 90 CLASSES</option>'+ALL_CLASSES.map(c=>`<option>${c}</option>`).join('');
  orders=demoOrders();
  try{ rtdb.ref('issues/'+mySchoolId).once('value').then(s=>{ if(s.val()) orders=Object.values(s.val()); renderOrders(); }).catch(()=>{}); }catch(e){}
  renderOrders();
}
function visibleOrders(){
  let q=toCaps(document.getElementById('searchOrders').value||''); let fSub=document.getElementById('filterSubject').value; let fGrade=document.getElementById('filterGrade').value; let fClass=document.getElementById('filterClass').value; let fStatus=document.getElementById('filterStatus').value;
  return orders.filter(o=>{
    if(myHodSubjects.length && !myHodSubjects.includes(toCaps(o.subject))) return false;
    if(fSub && toCaps(o.subject)!==fSub) return false;
    if(fGrade && String(o.grade)!==fGrade) return false;
    if(fClass && toCaps(o.className)!==fClass) return false;
    if(fStatus && toCaps(o.status)!==fStatus) return false;
    if(q && !(toCaps(o.learnerName)+' '+toCaps(o.title)+' '+toCaps(o.teacher)).includes(q)) return false;
    return true;
  });
}
function renderOrders(){
  let list=visibleOrders();
  document.getElementById('kpiPending').textContent=orders.filter(o=>myHodSubjects.includes(toCaps(o.subject))&&toCaps(o.status)==='PENDING HOD').length;
  document.getElementById('kpiApproved').textContent=orders.filter(o=>myHodSubjects.includes(toCaps(o.subject))&&toCaps(o.status)==='APPROVED').length;
  document.getElementById('kpiRejected').textContent=orders.filter(o=>myHodSubjects.includes(toCaps(o.subject))&&toCaps(o.status)==='REJECTED').length;
  document.getElementById('kpiTotal').textContent=orders.filter(o=>myHodSubjects.includes(toCaps(o.subject))).length;
  document.getElementById('ordersInfo').innerHTML=`Showing <b>${list.length}</b> orders for your HOD subjects: <b>${myHodSubjects.join(', ')}</b> — Classes 4A-12J — Other subjects hidden.`;
  document.getElementById('ordersTable').innerHTML=list.length?list.map(o=>`<tr><td><b>${toCaps(o.learnerName)}</b><br>${o.learnerId} — ${o.className} — Grade ${o.grade} ${ALL_CLASSES.includes(toCaps(o.className))?'':'<span style="color:#991b1b">⚠️ Invalid Class</span>'}</td><td><b>${toCaps(o.title)}</b><br>${o.barcode}</td><td>${toCaps(o.subject)}<br>Grade ${o.grade}</td><td>${toCaps(o.teacher)}</td><td>${toCaps(o.status)}</td><td>${toCaps(o.status)==='PENDING HOD'?`<button class="btn btn-green" onclick="setStatus('${o.barcode}','APPROVED')">✅ APPROVE</button> <button class="btn btn-red" onclick="setStatus('${o.barcode}','REJECTED')">❌ REJECT</button>`:'—'}</td></tr>`).join(''):`<tr><td colspan="6" style="text-align:center;padding:20px">No orders for your HOD subjects.</td></tr>`;
}
async function setStatus(code,status){
  let o=orders.find(x=>norm(x.barcode)===norm(code)); if(!o) return;
  if(myHodSubjects.length && !myHodSubjects.includes(toCaps(o.subject))){ alert('⛔ NOT YOUR SUBJECT — '+toCaps(o.subject)+' not in ['+myHodSubjects.join(', ')+']'); return; }
  if(!ALL_CLASSES.includes(toCaps(o.className))){ if(!confirm('⚠️ Class '+toCaps(o.className)+' is NOT 4A-12J (A-J). Approve anyway?')) return; }
  try{ await rtdb.ref('issues/'+mySchoolId+'/'+norm(code)+'/status').set(status); }catch(e){}
  o.status=status; document.getElementById('hodMsg').innerHTML=`<div class="ok">✅ ${status} — <b>${toCaps(o.title)}</b> — ${toCaps(o.learnerName)} — ${toCaps(o.className)}</div>`; renderOrders();
}
async function approveAllVisible(){ for(let o of visibleOrders().filter(x=>toCaps(x.status)==='PENDING HOD')) await setStatus(o.barcode,'APPROVED'); }
async function rejectAllVisible(){ for(let o of visibleOrders().filter(x=>toCaps(x.status)==='PENDING HOD')) await setStatus(o.barcode,'REJECTED'); }
loadAll();
</script></body></html>
