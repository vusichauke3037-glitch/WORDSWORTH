<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOD - Makhanani LTSM 2.0</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:#0a1f4d}
header{background:#0a1f4d;color:#fff;padding:14px 12px;text-align:center;border-bottom:4px solid #d4af37}
header h1{margin:0;font-size:20px}header p{margin:4px 0 0;font-size:12px;color:#d4af37}
.wrap{max-width:900px;margin:0 auto;padding:12px}
.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
h2{margin:0 0 10px;font-size:16px}label{font-weight:900;font-size:13px;display:block;margin-top:12px}
input,select{width:100%;padding:14px;border:2px solid #0a1f4d;border-radius:8px;font-size:16px;font-weight:700;background:#fff;color:#0a1f4d;cursor:pointer}
input{cursor:text}input:focus,select:focus{border-color:#d4af37;outline:none;background:#fef3c7}
.btn{border:none;border-radius:8px;padding:10px 12px;font-weight:900;cursor:pointer;font-size:13px}
.btn-full{width:100%;margin-top:12px}.btn-green{background:#0a1f4d;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}.btn-grey{background:#e2e8f0;color:#0a1f4d}.btn-red{background:#ef4444;color:#fff}.btn-teal{background:#0d9488;color:#fff}
.info{background:#fef3c7;border:2px solid #d4af37;border-radius:8px;padding:10px;font-size:13px;line-height:1.6;margin-top:10px}
.warn{background:#fee2e2;border:2px solid #ef4444;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.ok{background:#dcfce7;border:2px solid #22c55e;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}
.kpi div{background:#fff;border-radius:12px;padding:14px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.kpi b{font-size:20px;display:block}.kpi span{font-size:11px;font-weight:900;color:#64748b}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:10px 8px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:middle}th{background:#0a1f4d;color:#fff}
.pill{display:inline-block;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:900}.pill-pending{background:#fef3c7;color:#92400e}.pill-approved{background:#dcfce7;color:#166534}.pill-partial{background:#dbeafe;color:#1e40af}.pill-full{background:#e9d5ff;color:#6b21a8}.pill-rejected{background:#fee2e2;color:#991b1b}
.qty-input{width:80px;padding:10px;text-align:center;font-size:16px}
@media(max-width:700px){.kpi{grid-template-columns:repeat(2,1fr)}.row{flex-direction:column}}
</style></head>
<body>
<header><h1>👔 HOD — MAKHANANI LTSM 2.0</h1><p>APPROVE MY SUBJECT ONLY — SET APPROVED QTY — REQUEST 10, APPROVE 5 = LIBRARIAN ISSUES ONLY 5</p>
<div id="taskbar"></div><script src="nav.js"></script>
<script>guardPage(3,'HOD');</script>
</header>
<div class="wrap">
<div class="info" id="roleInfo">Loading...</div>
<div class="kpi"><div><b id="kpiPending">0</b><span>⏳ PENDING — My Subject<br>Waiting My Approval</span></div><div><b id="kpiApproved">0</b><span>✅ APPROVED BY ME<br>My Subject</span></div><div><b id="kpiRejected">0</b><span>❌ REJECTED BY ME</span></div><div><b id="kpiTotalApprovedQty">0</b><span>📦 TOTAL APPROVED QTY<br>By Me</span></div></div>

<div class="card"><h2>⏳ Pending Requests — My Subject Only — Set Approved Qty</h2>
<div class="info">You approve <b>ONLY <span id="mySubjectLabel">—</span></b> requests. Other subjects are hidden.<br><b>ApprovedQty ≤ RequestedQty</b> — You can approve less (partial) or full, never more.<br>Example: Teacher requests 10 → You approve 5 → Librarian can issue only 5.<br>Tap <b>✅ APPROVE</b> to approve that qty, <b>❌ REJECT</b> to reject all.</div>
<div id="pendingInfo" class="info">Loading...</div>
<div style="overflow-x:auto;margin-top:12px"><table><thead><tr><th>Teacher</th><th>Title / Class</th><th>Requested</th><th>Approved Qty<br>You Set</th><th>Action</th></tr></thead><tbody id="pendingTable"></tbody></table></div><div id="pendingMsg"></div></div>

<div class="card"><h2>📦 My Decisions — Approved / Rejected — My Subject</h2><div class="row"><div><label>🔍 Search</label><input id="searchDecided" placeholder="🔍 Teacher / Title" oninput="renderDecided()"></div><div><label>📊 Filter</label><select id="filterDecided" onchange="renderDecided()"><option value="">📊 ALL</option><option value="APPROVED">✅ APPROVED</option><option value="PARTIALLY ISSUED">📦 PARTIALLY ISSUED</option><option value="FULLY ISSUED">✅ FULLY ISSUED</option><option value="REJECTED">❌ REJECTED</option></select></div></div><div id="decidedInfo" class="info">Loading...</div><div style="overflow-x:auto;margin-top:12px"><table><thead><tr><th>Teacher</th><th>Title / Class</th><th>Requested</th><th>Approved</th><th>Issued</th><th>Remaining</th><th>Status</th><th>Action</th></tr></thead><tbody id="decidedTable"></tbody></table></div></div>
</div>
<script>
const firebaseConfig={apiKey:"AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA",authDomain:"makhanani-ltsm.firebaseapp.com",databaseURL:"https://makhanani-ltsm-default-rtdb.firebaseio.com",projectId:"makhanani-ltsm",storageBucket:"makhanani-ltsm.firebasestorage.app",messagingSenderId:"247180363183",appId:"1:247180363183:web:4e5a399d4e306192e01b5a",measurementId:"G-PEST1XFCR8"};
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const rtdb=firebase.database();
function toCaps(s){return String(s||'').trim().toUpperCase();}
let user=null;try{user=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
let mySubject=toCaps(user?.subject||'');
let mySchoolId=user?.schoolId||'WHS';
let orders=[];
function demoData(){
  orders=[
    {id:'ORD1',teacher:'MRS DUBE',teacherEmail:'dube@wordsworth.co.za',title:'MATHEMATICS GRADE 10',subject:'MATHEMATICS',grade:'10',className:'10A',qty:10,approvedQty:0,issuedQty:0,status:'PENDING',approvedBy:'',date:'2026-11-17'},
    {id:'ORD2',teacher:'MRS DUBE',teacherEmail:'dube@wordsworth.co.za',title:'MATHEMATICS GRADE 11',subject:'MATHEMATICS',grade:'11',className:'11A',qty:5,approvedQty:0,issuedQty:0,status:'PENDING',approvedBy:'',date:'2026-11-17'},
    {id:'ORD3',teacher:'MR SMITH',teacherEmail:'smith@wordsworth.co.za',title:'ENGLISH GRADE 10',subject:'ENGLISH',grade:'10',className:'10A',qty:3,approvedQty:3,issuedQty:1,status:'PARTIALLY ISSUED',approvedBy:'HOD ENGLISH',date:'2026-11-17'},
    {id:'ORD4',teacher:'MS JONES',teacherEmail:'jones@wordsworth.co.za',title:'HISTORY GRADE 12',subject:'HISTORY',grade:'12',className:'12A',qty:4,approvedQty:0,issuedQty:0,status:'PENDING',approvedBy:'',date:'2026-11-17'},
    {id:'ORD5',teacher:'MRS DUBE',teacherEmail:'dube@wordsworth.co.za',title:'MATHEMATICS GRADE 10',subject:'MATHEMATICS',grade:'10',className:'10B',qty:6,approvedQty:5,issuedQty:5,status:'FULLY ISSUED',approvedBy:'HOD MATHS',date:'2026-11-15'},
  ];
}
function myOrders(){ return orders.filter(o=>toCaps(o.subject)===mySubject); }
function remaining(o){ return Math.max(0,(o.approvedQty||0)-(o.issuedQty||0)); }
function loadAll(){
  document.getElementById('roleInfo').innerHTML=`👔 <b>${toCaps(user?.name||'HOD')}</b> — Role: <b>HOD — RANK 3</b> — Subject: <b>${mySubject||'—'}</b> — School: <b>${mySchoolId}</b><br><small>You approve ONLY ${mySubject} requests. You set Approved Qty. Librarian issues ONLY up to Approved Qty.</small>`;
  document.getElementById('mySubjectLabel').textContent=mySubject;
  demoData();
  try{ rtdb.ref('orders/'+mySchoolId).once('value').then(s=>{ if(s.val()){ orders=Object.values(s.val()); renderAll(); } }).catch(()=>{}); }catch(e){}
  renderAll();
}
function renderAll(){
  let mine=myOrders();
  let pending=mine.filter(o=>o.status==='PENDING');
  let decided=mine.filter(o=>o.status!=='PENDING');
  document.getElementById('kpiPending').textContent=pending.length;
  document.getElementById('kpiApproved').textContent=mine.filter(o=>['APPROVED','PARTIALLY ISSUED','FULLY ISSUED'].includes(o.status)).length;
  document.getElementById('kpiRejected').textContent=mine.filter(o=>o.status==='REJECTED').length;
  document.getElementById('kpiTotalApprovedQty').textContent=mine.reduce((s,o)=>s+(o.approvedQty||0),0);
  document.getElementById('pendingInfo').innerHTML=`Showing <b>${pending.length}</b> PENDING requests for <b>${mySubject}</b>. Other subjects hidden.`;
  document.getElementById('pendingTable').innerHTML=pending.length?pending.map(o=>`<tr><td><b>${toCaps(o.teacher)}</b><br><small>${o.date||''}</small></td><td><b>${toCaps(o.title)}</b><br>${toCaps(o.className)} — Grade ${o.grade}</td><td><b>${o.qty}</b><br><small>Requested</small></td><td><input class="qty-input" id="qty_${o.id}" type="number" value="${o.qty}" min="1" max="${o.qty}" oninput="clampQty('${o.id}',${o.qty})"><br><small>Max ${o.qty}<br>1-${o.qty}</small></td><td><button class="btn btn-green" onclick="approveOrder('${o.id}')">✅ APPROVE<br><span id="approveLabel_${o.id}">Approve ${o.qty}</span></button> <button class="btn btn-red" onclick="rejectOrder('${o.id}')">❌ REJECT</button></td></tr>`).join(''):`<tr><td colspan="5" style="text-align:center;padding:20px">No PENDING requests for ${mySubject}. All done ✅</td></tr>`;
  renderDecided();
}
function clampQty(id, max){
  let el=document.getElementById('qty_'+id);
  let v=parseInt(el.value||'0',10);
  if(isNaN(v)||v<1) v=1;
  if(v>max) v=max;
  el.value=v;
  let lbl=document.getElementById('approveLabel_'+id);
  if(lbl) lbl.textContent='Approve '+v;
}
async function approveOrder(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  let qtyEl=document.getElementById('qty_'+id);
  let approvedQty=qtyEl?parseInt(qtyEl.value||o.qty,10):o.qty;
  if(isNaN(approvedQty)||approvedQty<1){ document.getElementById('pendingMsg').innerHTML='<div class="warn">⚠️ Approved Qty must be 1 to '+o.qty+'.</div>'; return; }
  if(approvedQty>o.qty){ document.getElementById('pendingMsg').innerHTML='<div class="warn">⛔ Approved Qty cannot be more than Requested '+o.qty+'.</div>'; return; }
  if(!confirm(`✅ APPROVE ${approvedQty} of ${o.qty}?\n\nTeacher: ${o.teacher}\nTitle: ${o.title}\nClass: ${o.className}\n\nLibrarian can issue ONLY ${approvedQty} books for this order.\n${approvedQty<o.qty? (o.qty-approvedQty)+' books NOT approved — Teacher will see Requested '+o.qty+', Approved '+approvedQty+'.' : 'Full approval.'}`)) return;
  o.approvedQty=approvedQty; o.issuedQty=0; o.status='APPROVED'; o.approvedBy=toCaps(user?.name||'HOD');
  try{ await rtdb.ref('orders/'+mySchoolId+'/'+id).update({approvedQty:approvedQty,issuedQty:0,status:'APPROVED',approvedBy:o.approvedBy}); }catch(e){}
  document.getElementById('pendingMsg').innerHTML=`<div class="ok">✅ APPROVED — <b>${approvedQty} of ${o.qty}</b> — ${toCaps(o.teacher)} — ${toCaps(o.title)}<br>Librarian can now issue up to <b>${approvedQty}</b> books. ${approvedQty<o.qty?'<b>Partial approval</b> — '+(o.qty-approvedQty)+' not approved.':''}</div>`;
  renderAll();
}
async function rejectOrder(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  if(!confirm(`❌ REJECT this order?\n\nTeacher: ${o.teacher}\nTitle: ${o.title} — ${o.qty}x\n\nLibrarian CANNOT issue any books for this order.`)) return;
  o.approvedQty=0; o.issuedQty=0; o.status='REJECTED'; o.approvedBy=toCaps(user?.name||'HOD');
  try{ await rtdb.ref('orders/'+mySchoolId+'/'+id).update({approvedQty:0,issuedQty:0,status:'REJECTED',approvedBy:o.approvedBy}); }catch(e){}
  document.getElementById('pendingMsg').innerHTML=`<div class="warn">❌ REJECTED — ${toCaps(o.teacher)} — ${toCaps(o.title)} — Approved 0 — Librarian cannot issue.</div>`;
  renderAll();
}
async function changeApprovedQty(id){
  let o=orders.find(x=>String(x.id)===String(id)); if(!o) return;
  let input=document.getElementById('changeQty_'+id);
  let newQty=input?parseInt(input.value||'0',10):0;
  if(isNaN(newQty)||newQty<0||newQty>o.qty){ alert('Approved Qty must be 0 to '+o.qty); return; }
  if(newQty < (o.issuedQty||0)){ alert('Cannot set Approved Qty to '+newQty+' — Already issued '+o.issuedQty+' books.\n\nApproved Qty must be ≥ Issued Qty.'); return; }
  if(!confirm(`Change Approved Qty from ${o.approvedQty} to ${newQty}?\n\nTeacher: ${o.teacher}\nTitle: ${o.title}\nAlready Issued: ${o.issuedQty}\nNew Remaining: ${newQty - o.issuedQty}`)) return;
  o.approvedQty=newQty;
  o.status=newQty===0?'REJECTED':(o.issuedQty===0?'APPROVED':(remaining(o)===0?'FULLY ISSUED':'PARTIALLY ISSUED'));
  if(newQty>0) o.approvedBy=toCaps(user?.name||'HOD');
  try{ await rtdb.ref('orders/'+mySchoolId+'/'+id).update({approvedQty:newQty,status:o.status,approvedBy:o.approvedBy}); }catch(e){}
  renderAll();
}
function renderDecided(){
  let q=toCaps(document.getElementById('searchDecided').value||'');
  let f=document.getElementById('filterDecided').value;
  let list=myOrders().filter(o=>o.status!=='PENDING').filter(o=>{ if(f && o.status!==f) return false; if(q && !(toCaps(o.teacher)+' '+toCaps(o.title)).includes(q)) return false; return true; });
  document.getElementById('decidedInfo').innerHTML=`Showing <b>${list.length}</b> decided orders for <b>${mySubject}</b>. You can change Approved Qty here — If Librarian already issued some, Approved cannot go below Issued.`;
  document.getElementById('decidedTable').innerHTML=list.length?list.map(o=>{
    let pill=o.status==='APPROVED'?'pill-approved':o.status==='PARTIALLY ISSUED'?'pill-partial':o.status==='FULLY ISSUED'?'pill-full':'pill-rejected';
    return `<tr><td><b>${toCaps(o.teacher)}</b></td><td><b>${toCaps(o.title)}</b><br>${toCaps(o.className)}</td><td>${o.qty}</td><td><b>${o.approvedQty}</b><br><small>by ${toCaps(o.approvedBy||'')}</small></td><td>${o.issuedQty}</td><td>${remaining(o)}</td><td><span class="pill ${pill}">${toCaps(o.status)}</span></td><td><input class="qty-input" id="changeQty_${o.id}" type="number" value="${o.approvedQty}" min="0" max="${o.qty}"> <button class="btn btn-teal" onclick="changeApprovedQty('${o.id}')">✏️ UPDATE APPROVED</button></td></tr>`;
  }).join(''):`<tr><td colspan="8" style="text-align:center;padding:20px">No decided orders yet.</td></tr>`;
}
loadAll();
</script></body></html>
