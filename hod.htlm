<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOD Dashboard - Makhanani LTSM 2.0</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#0f172a;color:#0a1f4d}
header{background:#0a1f4d;color:#fff;padding:14px 12px;text-align:center;border-bottom:4px solid #d4af37}
header h1{margin:0;font-size:20px}header p{margin:4px 0 0;font-size:12px;color:#d4af37}
.wrap{max-width:1100px;margin:0 auto;padding:12px}.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
h2{margin:0 0 10px;font-size:16px}label{font-weight:900;font-size:13px;display:block;margin-top:12px}
input,select{width:100%;padding:14px;border:2px solid #0a1f4d;border-radius:8px;font-size:16px;font-weight:700;background:#fff;color:#0a1f4d}
.btn{border:none;border-radius:8px;padding:12px 12px;font-weight:900;cursor:pointer;font-size:13px}.btn-full{width:100%;margin-top:12px}.btn-green{background:#0a1f4d;color:#fff}.btn-gold{background:#d4af37;color:#0a1f4d}.btn-grey{background:#e2e8f0;color:#0a1f4d}.btn-red{background:#ef4444;color:#fff}.btn-teal{background:#0d9488;color:#fff}.btn-purple{background:#7c3aed;color:#fff}.btn-blue{background:#2563eb;color:#fff}
.info{background:#fef3c7;border:2px solid #d4af37;border-radius:8px;padding:10px;font-size:13px;line-height:1.7;margin-top:10px}
.ok{background:#dcfce7;border:2px solid #22c55e;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.warn{background:#fee2e2;border:2px solid #ef4444;border-radius:8px;padding:10px;font-size:13px;margin-top:10px}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}.kpi div{background:#fff;border-radius:12px;padding:14px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.2)}.kpi b{font-size:22px;display:block}.kpi span{font-size:11px;font-weight:900;color:#64748b}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tile{background:#fff;border-radius:12px;padding:16px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);border-top:6px solid #7c3aed}.tile b{font-size:16px;display:block}.tile span{font-size:12px;color:#64748b;line-height:1.5}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px 8px;border-bottom:1px solid #e2e8f0;text-align:left}th{background:#0a1f4d;color:#fff}
@media(max-width:700px){.kpi{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.row{flex-direction:column}}
</style></head>
<body>
<header><h1>✅ HOD DASHBOARD — MAKHANANI LTSM 2.0 — V2.18</h1><p>HOD ONLY — APPROVE TEACHER REQUESTS — MY DEPARTMENT ONLY — MY DEPT RETRIEVAL % — MY SCHOOL ONLY</p>
<div id="taskbar"></div><script src="nav.js"></script>
<script>guardPage(4,'HOD Dashboard');</script>
</header>
<div class="wrap">
<div class="card"><h2>👤 Who Am I — HOD Only</h2><div class="info" id="roleInfo">Loading...</div>
<div class="row"><button class="btn btn-purple" onclick="go('manuals.html')">📖 OPEN MANUALS → HOD MANUAL</button><button class="btn btn-green" onclick="go('index.html')">🏠 HOME →</button><button class="btn btn-gold" onclick="go('subscriptions.html')">💰 SUBSCRIPTIONS →</button></div></div>

<!-- ===== MY DEPARTMENT FILTER ===== -->
<div class="card"><h2>🏫 My Department — Filter Everything To My Department</h2>
<div class="info">HOD manages 1 department — e.g. MATHS. Pick your department below — Retrieval % + Learners + Books + Issues + Approvals will filter to that department only. If you are HOD for 2 departments, pick one, check, then pick the other.</div>
<label>My Department / Subject</label><select id="myDeptFilter" onchange="onDeptChange()">
<option value="ALL">ALL DEPARTMENTS — All subjects I manage</option>
<option value="MATHS">MATHS — Mathematics</option>
<option value="ENGLISH">ENGLISH — English</option>
<option value="AFRIKAANS">AFRIKAANS</option>
<option value="ZULU">ZULU — isiZulu</option>
<option value="SCIENCE">SCIENCE — Natural Science</option>
<option value="SOCIAL SCIENCE">SOCIAL SCIENCE</option>
<option value="LIFE SKILLS">LIFE SKILLS</option>
<option value="TECHNOLOGY">TECHNOLOGY</option>
<option value="ARTS">ARTS — Creative Arts</option>
<option value="PHYSICS">PHYSICS</option>
<option value="CHEMISTRY">CHEMISTRY</option>
<option value="BIOLOGY">BIOLOGY — Life Sciences</option>
<option value="GEOGRAPHY">GEOGRAPHY</option>
<option value="HISTORY">HISTORY</option>
<option value="ACCOUNTING">ACCOUNTING</option>
<option value="BUSINESS">BUSINESS — Business Studies</option>
<option value="ECONOMICS">ECONOMICS</option>
<option value="LO">LO — Life Orientation</option>
<option value="CAT">CAT — Computer Applications</option>
<option value="IT">IT — Information Technology</option>
</select>
<label>My Class Filter — Optional — Leave ALL to see all classes in my department</label><select id="myClassFilter" onchange="onDeptChange()">
<option value="ALL">ALL CLASSES — 4A to 12J</option>
<option value="4A">4A</option><option value="4B">4B</option><option value="4C">4C</option><option value="4D">4D</option><option value="4E">4E</option><option value="4F">4F</option><option value="4G">4G</option><option value="4H">4H</option><option value="4I">4I</option><option value="4J">4J</option>
<option value="5A">5A</option><option value="5B">5B</option><option value="5C">5C</option><option value="5D">5D</option><option value="5E">5E</option><option value="5F">5F</option><option value="5G">5G</option><option value="5H">5H</option><option value="5I">5I</option><option value="5J">5J</option>
<option value="6A">6A</option><option value="6B">6B</option><option value="6C">6C</option><option value="6D">6D</option><option value="6E">6E</option><option value="6F">6F</option><option value="6G">6G</option><option value="6H">6H</option><option value="6I">6I</option><option value="6J">6J</option>
<option value="7A">7A</option><option value="7B">7B</option><option value="7C">7C</option><option value="7D">7D</option><option value="7E">7E</option><option value="7F">7F</option><option value="7G">7G</option><option value="7H">7H</option><option value="7I">7I</option><option value="7J">7J</option>
<option value="8A">8A</option><option value="8B">8B</option><option value="8C">8C</option><option value="8D">8D</option><option value="8E">8E</option><option value="8F">8F</option><option value="8G">8G</option><option value="8H">8H</option><option value="8I">8I</option><option value="8J">8J</option>
<option value="9A">9A</option><option value="9B">9B</option><option value="9C">9C</option><option value="9D">9D</option><option value="9E">9E</option><option value="9F">9F</option><option value="9G">9G</option><option value="9H">9H</option><option value="9I">9I</option><option value="9J">9J</option>
<option value="10A">10A</option><option value="10B">10B</option><option value="10C">10C</option><option value="10D">10D</option><option value="10E">10E</option><option value="10F">10F</option><option value="10G">10G</option><option value="10H">10H</option><option value="10I">10I</option><option value="10J">10J</option>
<option value="11A">11A</option><option value="11B">11B</option><option value="11C">11C</option><option value="11D">11D</option><option value="11E">11E</option><option value="11F">11F</option><option value="11G">11G</option><option value="11H">11H</option><option value="11I">11I</option><option value="11J">11J</option>
<option value="12A">12A</option><option value="12B">12B</option><option value="12C">12C</option><option value="12D">12D</option><option value="12E">12E</option><option value="12F">12F</option><option value="12G">12G</option><option value="12H">12H</option><option value="12I">12I</option><option value="12J">12J</option>
</select>
<div class="row"><button class="btn btn-green" onclick="saveMyDept()">💾 SAVE MY DEPARTMENT</button><button class="btn btn-gold" onclick="onDeptChange()">🔄 REFRESH MY DEPT RETRIEVAL %</button></div>
<div id="deptMsg"></div></div>

<!-- ===== KPI — 6 CARDS — MY DEPT ONLY ===== -->
<div class="kpi"><div><b id="kpiLearners">0</b><span>👩‍🎓 MY DEPT LEARNERS</span></div><div><b id="kpiBooks">0</b><span>📚 MY DEPT BOOKS</span></div><div><b id="kpiClasses">0</b><span>🏫 MY DEPT CLASSES</span></div><div><b id="kpiIssues">0</b><span>📕 MY DEPT ISSUED</span></div><div><b id="kpiReturned">0</b><span>✅ MY DEPT RETURNED</span></div><div style="border-top:4px solid #22c55e"><b id="kpiRetrieval">0%</b><span>♻️ MY DEPT RETRIEVAL %</span></div></div>

<!-- ===== RETRIEVAL PERCENTAGE — V1.0 — HOD — MY DEPT ONLY ===== -->
<div class="card"><h2>♻️ My Department Retrieval Percentage — Books Returned / Books Issued — My Department Only</h2>
<div class="info" id="retrievalInfo">Loading my dept retrieval...</div>
<div class="info" style="background:#e2e8f0;padding:4px;border-radius:8px"><div id="retrievalBar" style="background:#22c55e;height:22px;border-radius:6px;width:0%;text-align:center;color:#fff;font-weight:900;font-size:12px;line-height:22px">0%</div></div>
<div class="info"><b>Formula:</b> My Dept Retrieval % = (My Dept Returned / My Dept Issued) x 100 — <b>Target:</b> 100% — <b>Good:</b> 95%+ Green — <b>Warning:</b> 85-94% Orange — <b>Bad:</b> Below 85% Red — HOD must chase teachers in department who did not return books.</div>
<div class="row"><button class="btn btn-green" onclick="loadRetrieval()">🔄 REFRESH MY DEPT RETRIEVAL %</button><button class="btn btn-gold" onclick="go('principal.html')">👑 PRINCIPAL — SEE WHOLE SCHOOL →</button></div>
<div id="stillOutList"></div></div>
<div class="card"><h2>♻️ My Dept Retrieval % By Class — Which Class In My Department Returns Books?</h2><div id="retrievalByClass">Loading...</div><div class="row"><button class="btn btn-green" onclick="loadRetrievalByClass()">🔄 REFRESH BY CLASS</button></div></div>

<!-- ===== APPROVALS ===== -->
<div class="card"><h2>✅ Approvals — Approve / Reject Teacher Requests — My Department Only</h2>
<div class="info">Teacher requests appear here when teacher asks for books / stock / learners in your department. HOD approves → Principal sees approved. If you reject, write reason — Teacher sees reason.</div>
<label>Teacher Name</label><input id="aTeacher" placeholder="MRS NKOSI">
<label>Request — What does teacher want?</label><input id="aRequest" placeholder="Need 10 MATHS GRADE 4 books for 4A">
<label>Class</label><input id="aClass" placeholder="4A">
<label>Department / Subject</label><input id="aDept" placeholder="MATHS">
<div class="row"><button class="btn btn-teal" onclick="addApproval('PENDING')">➕ ADD REQUEST</button><button class="btn btn-green" onclick="loadApprovals()">🔄 REFRESH APPROVALS</button></div>
<div id="approvalMsg"></div>
<div style="overflow-x:auto;margin-top:10px"><table><thead><tr><th>Teacher</th><th>Request</th><th>Class</th><th>Dept</th><th>Status</th><th>Actions</th></tr></thead><tbody id="approvalsBody"></tbody></table></div></div>

<!-- ===== TEACHERS IN MY DEPT ===== -->
<div class="card"><h2>👩‍🏫 Teachers In My Department</h2><div class="info">Teachers who teach your subject — From Users list — Filtered by department.</div><div id="teachersList">Loading...</div><div class="row"><button class="btn btn-green" onclick="loadTeachers()">🔄 REFRESH TEACHERS</button><button class="btn btn-gold" onclick="go('users.html')">👥 OPEN USERS →</button></div></div>

<!-- ===== DEPARTMENT REPORT ===== -->
<div class="card"><h2>📊 Department Report — My Department Only</h2><div class="info" id="deptReport">Loading report...</div><div class="row"><button class="btn btn-green" onclick="loadDeptReport()">🔄 REFRESH REPORT</button><button class="btn btn-gold" onclick="go('teacher.html')">👩‍🏫 TEACHER DASHBOARD →</button></div></div>

<!-- ===== MY SUBSCRIPTION — READ ONLY ===== -->
<div class="card"><h2>💰 My Subscription — My School Only — Read Only</h2><div class="info" id="mySub">Loading subscription...</div>
<div class="row"><button class="btn btn-gold" onclick="requestPkg('STANDARD')">📱 REQUEST UPGRADE → WhatsApp 078 023 3263</button><button class="btn btn-green" onclick="go('subscriptions.html')">💰 OPEN FULL SUBSCRIPTIONS →</button></div></div>

<!-- ===== PRICE LIST ===== -->
<div class="card" id="priceList"><h2>💰 Price List — Packages — Per School</h2>
<div class="grid">
<div class="tile" style="border-top-color:#0d9488;text-align:center"><b>DEMO</b><span>7 days free trial</span><div style="color:#0d9488;font-size:22px;font-weight:900;margin:8px 0">Setup: FREE</div><span>Monthly: <b>FREE</b><br>Once-off: <b>FREE</b></span><div class="row"><button class="btn btn-teal" onclick="requestPkg('DEMO')">📱 REQUEST DEMO</button></div></div>
<div class="tile" style="border-top-color:#0a1f4d;text-align:center"><b>STARTER</b><span>Starter — 1 school</span><div style="color:#0d9488;font-size:22px;font-weight:900;margin:8px 0">Setup: R3 000</div><span>Monthly: <b>R350 / month</b><br>Once-off: <b>R4 500 once-off / year</b></span><div class="row"><button class="btn btn-green" onclick="requestPkg('STARTER')">📱 REQUEST STARTER</button></div></div>
<div class="tile" style="border-top-color:#d4af37;text-align:center"><b>STANDARD</b><span>Most popular</span><div style="color:#0d9488;font-size:22px;font-weight:900;margin:8px 0">Setup: R4 500</div><span>Monthly: <b>R500 / month</b><br>Once-off: <b>R7 500 once-off / year</b></span><div class="row"><button class="btn btn-gold" onclick="requestPkg('STANDARD')">📱 REQUEST STANDARD</button></div></div>
<div class="tile" style="border-top-color:#7c3aed;text-align:center"><b>PREMIUM</b><span>Premium</span><div style="color:#0d9488;font-size:22px;font-weight:900;margin:8px 0">Setup: R5 500</div><span>Monthly: <b>R600 / month</b><br>Once-off: <b>R9 000 once-off / year</b></span><div class="row"><button class="btn btn-purple" onclick="requestPkg('PREMIUM')">📱 REQUEST PREMIUM</button></div></div>
</div></div>
<div class="card"><div class="row"><button class="btn btn-grey" onclick="navBack()">⬅️ BACK</button><button class="btn btn-green" onclick="go('index.html')">🏠 HOME →</button></div></div>
</div>
<script>
const firebaseConfig={apiKey:"AIzaSyDPcF5zaCD6Mp9TfpiMPoc3xG0qSPwO7oA",authDomain:"makhanani-ltsm.firebaseapp.com",databaseURL:"https://makhanani-ltsm-default-rtdb.firebaseio.com",projectId:"makhanani-ltsm",storageBucket:"makhanani-ltsm.firebasestorage.app",messagingSenderId:"247180363183",appId:"1:247180363183:web:4e5a399d4e306192e01b5a",measurementId:"G-PEST1XFCR8"};
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const rtdb=firebase.database();
function toCaps(s){return String(s||'').trim().toUpperCase();}
function go(page){window.location.href=page;}
let user=null;try{user=JSON.parse(localStorage.getItem('makhanani_user')||'null');}catch(e){}
// ===== WHATSAPP — 078 023 3263 =====
const WA_NUMBER='27780233263';
function requestPkg(pkg){
  let p=String(pkg||'').toUpperCase();
  let prices={DEMO:'Setup: FREE — Monthly: FREE — Once-off: FREE — 7 days free trial',STARTER:'Setup: R3 000 — Monthly: R350 / month — Once-off: R4 500 / year',STANDARD:'Setup: R4 500 — Monthly: R500 / month — Once-off: R7 500 / year',PREMIUM:'Setup: R5 500 — Monthly: R600 / month — Once-off: R9 000 / year'};
  let msg='Hello Makhanani LTSM 2.0 👋\n\nI want to REQUEST: '+p+'\n'+(prices[p]||'')+'\nSchool: '+((user&&user.schoolName)||'MY SCHOOL')+'\nName: '+((user&&user.name)||'')+'\n\nPlease activate my package.';
  window.open('https://wa.me/'+WA_NUMBER+'?text='+encodeURIComponent(msg), '_blank');
}
// ===== MY DEPT FILTER =====
function getMyDept(){ return document.getElementById('myDeptFilter').value||'ALL'; }
function getMyClass(){ return document.getElementById('myClassFilter').value||'ALL'; }
function onDeptChange(){ loadRetrieval(); loadRetrievalByClass(); loadApprovals(); loadTeachers(); loadDeptReport(); }
function saveMyDept(){
  let d=getMyDept(); let c=getMyClass();
  try{ let u=JSON.parse(localStorage.getItem('makhanani_user')||'{}'); u.subject=d; u.department=d; u.className=c; localStorage.setItem('makhanani_user', JSON.stringify(u)); user=u; }catch(e){}
  document.getElementById('deptMsg').innerHTML='<div class="ok">✅ Saved My Department: <b>'+d+'</b> — Class: <b>'+c+'</b> — Retrieval % + Approvals filtered to this department.</div>';
  // Auto-fill approval dept
  document.getElementById('aDept').value=d;
}
// ===== FILTER — MY DEPT ONLY =====
// Issues / Stock have subject — Learners have class only, so HOD learners = learners in classes that have issues in my dept OR all learners if dept=ALL
// Simpler: For issues/stock, filter by subject. For learners, filter by class if class filter set, else all.
function matchesMyDeptForIssue(x){
  let d=getMyDept(); if(d==='ALL') return true;
  let s=toCaps(x.subject||'');
  // Issues often have no subject — Fall back to bookTitle contains dept? If no subject, include if class matches or if dept is in title
  if(!s){ let t=toCaps(x.bookTitle||''); if(t.includes(d)) return true; return true; } // Include if unknown — HOD still sees it, Principal sees all
  return s===d;
}
function matchesMyClassForIssue(x){
  let c=getMyClass(); if(c==='ALL') return true;
  return toCaps(x.className||x.class||'')===c;
}
// ===== RETRIEVAL PERCENTAGE — V1.0 — HOD — MY DEPT ONLY =====
async function loadRetrieval(){
  let info=document.getElementById('retrievalInfo'); let bar=document.getElementById('retrievalBar'); let kpiRet=document.getElementById('kpiRetrieval'); let kpiRetCount=document.getElementById('kpiReturned'); let stillEl=document.getElementById('stillOutList');
  if(!user){ if(info) info.innerHTML='🔒 Login to see My Dept Retrieval %.'; return; }
  let sid=user.schoolId||'WHS'; let myDept=getMyDept();
  try{
    let snap=await rtdb.ref('issues/'+sid).once('value'); let all=Object.values(snap.val()||{});
    let list=all.filter(x=>matchesMyDeptForIssue(x) && matchesMyClassForIssue(x));
    let total=list.length; let returned=list.filter(x=>String(x.status||'').toUpperCase()==='RETURNED').length; let lost=list.filter(x=>String(x.status||'').toUpperCase()==='LOST').length; let stillOut=total-returned;
    let pct=total>0?Math.round((returned/total)*100):0; let lostPct=total>0?Math.round((lost/total)*100):0;
    let color=pct>=95?'#22c55e':pct>=85?'#f59e0b':'#ef4444';
    let msg=pct>=95?'✅ EXCELLENT — Almost all dept books back.':pct>=85?'⚠️ WARNING — Follow up teachers in dept who did not return.':'🚨 BAD — Many dept books not returned — HOD must chase teachers + Tell Principal.';
    if(kpiRet) kpiRet.textContent=pct+'%'; if(kpiRetCount) kpiRetCount.textContent=returned;
    if(document.getElementById('kpiIssues')) document.getElementById('kpiIssues').textContent=total;
    if(bar){ bar.style.width=pct+'%'; bar.style.background=color; bar.textContent=pct+'%'; }
    if(info) info.innerHTML=`📕 My Dept Issued: <b>${total}</b> — ✅ My Dept Returned: <b>${returned}</b> — 📕 Still Out: <b>${stillOut}</b> — ❌ Lost: <b>${lost}</b><br>♻️ My Dept Retrieval %: <b style="color:${color}">${pct}%</b> — Lost %: <b>${lostPct}%</b><br>${msg}<br>🏫 School: <b>${String(user.schoolName||'').toUpperCase()}</b> (${sid}) — 📖 Department: <b>${myDept}</b> — 🏫 Class: <b>${getMyClass()}</b><br><i>Note: Issues without subject are counted in ALL departments — Ask Librarian to add subject when issuing.</i>`;
    if(stillEl){
      let out=list.filter(x=>String(x.status||'').toUpperCase()!=='RETURNED').slice(0,20);
      if(!out.length){ stillEl.innerHTML='<div class="ok">✅ No books still out in my department — All returned!</div>'; }
      else { let html='<div style="overflow-x:auto"><table><thead><tr><th>Learner</th><th>Class</th><th>Book</th><th>Status</th></tr></thead><tbody>';
        out.forEach(x=>{ html+=`<tr><td><b>${String(x.learnerName||x.learnerId||'').toUpperCase()}</b><br>${x.learnerId||''}</td><td>${x.className||x.class||''}</td><td>${String(x.bookTitle||x.bookId||'').toUpperCase()}</td><td>${String(x.status||'ISSUED').toUpperCase()}</td></tr>`; });
        html+='</tbody></table></div><div class="info">Showing first 20 still-out in my department. Chase teachers in department.</div>'; stillEl.innerHTML=html; }
    }
  }catch(e){ if(info) info.innerHTML='Load failed: '+e.message; }
}
async function loadRetrievalByClass(){
  let el=document.getElementById('retrievalByClass'); if(!el||!user) return; let sid=user.schoolId||'WHS';
  try{ let snap=await rtdb.ref('issues/'+sid).once('value'); let list=Object.values(snap.val()||{}).filter(x=>matchesMyDeptForIssue(x) && matchesMyClassForIssue(x)); let byClass={};
    list.forEach(x=>{ let c=String(x.className||x.class||'NO CLASS').toUpperCase(); if(!byClass[c]) byClass[c]={total:0,ret:0}; byClass[c].total++; if(String(x.status||'').toUpperCase()==='RETURNED') byClass[c].ret++; });
    if(!Object.keys(byClass).length){ el.innerHTML='<div class="info">No issues yet in my department — No retrieval data.</div>'; return; }
    let html='<div style="overflow-x:auto"><table><thead><tr><th>Class</th><th>Issued</th><th>Returned</th><th>Still Out</th><th>Retrieval %</th></tr></thead><tbody>';
    Object.keys(byClass).sort().forEach(c=>{ let d=byClass[c]; let pct=d.total>0?Math.round((d.ret/d.total)*100):0; let col=pct>=95?'#22c55e':pct>=85?'#f59e0b':'#ef4444'; html+=`<tr><td><b>${c}</b></td><td>${d.total}</td><td>${d.ret}</td><td>${d.total-d.ret}</td><td><b style="color:${col}">${pct}%</b></td></tr>`; });
    html+='</tbody></table></div>'; el.innerHTML=html;
  }catch(e){ el.innerHTML='Load failed: '+e.message; }
}
// ===== APPROVALS =====
async function addApproval(status){
  let sid=user.schoolId||'WHS'; let teacher=toCaps(document.getElementById('aTeacher').value); let req=document.getElementById('aRequest').value; let cls=toCaps(document.getElementById('aClass').value); let dept=toCaps(document.getElementById('aDept').value||getMyDept());
  if(!teacher||!req){ document.getElementById('approvalMsg').innerHTML='<div class="warn">Fill Teacher Name + Request.</div>'; return; }
  let id='APP-'+Date.now();
  let data={id:id,teacher:teacher,request:req,className:cls,class:cls,department:dept,subject:dept,status:status||'PENDING',createdAt:Date.now(),hod:user?user.name:'',schoolId:sid};
  try{ await rtdb.ref('approvals/'+sid+'/'+id).set(data); document.getElementById('approvalMsg').innerHTML='<div class="ok">✅ Added Request: <b>'+teacher+'</b> — '+req+' — Status PENDING</div>'; loadApprovals(); }catch(e){ document.getElementById('approvalMsg').innerHTML='<div class="warn">'+e.message+'</div>'; }
}
async function setApproval(id, status){
  let sid=user.schoolId||'WHS';
  if(!confirm('Mark this request as '+status+'?')) return;
  try{ await rtdb.ref('approvals/'+sid+'/'+id).update({status:status,approvedBy:user?user.name:'',approvedAt:Date.now()}); loadApprovals(); }catch(e){ alert(e.message); }
}
async function loadApprovals(){
  let el=document.getElementById('approvalsBody'); if(!el||!user) return; let sid=user.schoolId||'WHS'; let myDept=getMyDept();
  try{ let snap=await rtdb.ref('approvals/'+sid).once('value'); let list=Object.values(snap.val()||{}).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    let filtered=list.filter(x=>{ if(myDept!=='ALL' && toCaps(x.department||x.subject||'')!==myDept && toCaps(x.department||x.subject||'')!=='') return false; if(getMyClass()!=='ALL' && toCaps(x.className||x.class||'')!==getMyClass()) return false; return true; });
    if(!filtered.length){ el.innerHTML='<tr><td colspan="6" style="text-align:center">No approvals in my department — Add request above.</td></tr>'; return; }
    el.innerHTML=''; filtered.slice(0,50).forEach(x=>{ let tr=document.createElement('tr'); let col=String(x.status||'').toUpperCase()==='APPROVED'?'#22c55e':String(x.status||'').toUpperCase()==='REJECTED'?'#ef4444':'#f59e0b'; tr.innerHTML=`<td><b>${toCaps(x.teacher)}</b></td><td>${x.request||''}</td><td>${x.className||x.class||''}</td><td>${x.department||x.subject||''}</td><td><b style="color:${col}">${String(x.status||'').toUpperCase()}</b></td><td><button class="btn btn-teal" onclick="setApproval('${x.id}','APPROVED')">✅ APPROVE</button> <button class="btn btn-red" onclick="setApproval('${x.id}','REJECTED')">❌ REJECT</button></td>`; el.appendChild(tr); });
  }catch(e){ el.innerHTML='<tr><td colspan="6">'+e.message+'</td></tr>'; }
}
// ===== TEACHERS IN MY DEPT =====
async function loadTeachers(){
  let el=document.getElementById('teachersList'); if(!el||!user) return; let myDept=getMyDept();
  try{ let snap=await rtdb.ref('users').once('value'); let list=Object.values(snap.val()||{}).filter(x=>{
    let role=toCaps(x.role||''); if(role!=='TEACHER' && role!=='HOD') return false;
    if(myDept!=='ALL' && toCaps(x.subject||x.department||'')!==myDept && toCaps(x.subject||x.department||'')!=='') return false;
    return true;
  });
    if(document.getElementById('kpiLearners')){ /* learners KPI set in report */ }
    if(!list.length){ el.innerHTML='<div class="info">No teachers in my department — Add teachers in Users.</div>'; return; }
    let html='<div style="overflow-x:auto"><table><thead><tr><th>Teacher</th><th>Role</th><th>Subject / Dept</th><th>Class</th><th>School</th></tr></thead><tbody>';
    list.slice(0,50).forEach(u=>{ html+=`<tr><td><b>${toCaps(u.name)}</b><br>${u.email||''}</td><td>${toCaps(u.role)}</td><td>${toCaps(u.subject||u.department||'')}</td><td>${toCaps(u.className||u.class||'')}</td><td>${toCaps(u.schoolName||'')}</td></tr>`; });
    html+='</tbody></table></div>'; el.innerHTML=html;
  }catch(e){ el.innerHTML='Load failed: '+e.message; }
}
// ===== DEPT REPORT =====
async function loadDeptReport(){
  let el=document.getElementById('deptReport'); if(!el||!user) return; let sid=user.schoolId||'WHS'; let myDept=getMyDept();
  try{
    let [ls,bs,is]=await Promise.all([rtdb.ref('learners/'+sid).once('value'),rtdb.ref('stock/'+sid).once('value'),rtdb.ref('issues/'+sid).once('value')]);
    let lList=Object.values(ls.val()||{}); let bList=Object.values(bs.val()||{}).filter(x=>{ if(myDept==='ALL') return true; let s=toCaps(x.subject||''); return s===myDept || s===''; });
    let iList=Object.values(is.val()||{}).filter(x=>matchesMyDeptForIssue(x) && matchesMyClassForIssue(x));
    let classes=new Set(lList.map(x=>toCaps(x.className||x.class||''))); classes.delete('');
    if(document.getElementById('kpiLearners')) document.getElementById('kpiLearners').textContent=lList.length;
    if(document.getElementById('kpiBooks')) document.getElementById('kpiBooks').textContent=bList.length;
    if(document.getElementById('kpiClasses')) document.getElementById('kpiClasses').textContent=classes.size||0;
    let ret=iList.filter(x=>String(x.status||'').toUpperCase()==='RETURNED').length;
    let pct=iList.length>0?Math.round((ret/iList.length)*100):0;
    el.innerHTML=`🏫 <b>${toCaps(user.schoolName)}</b> (${sid}) — Department: <b>${myDept}</b> — Class: <b>${getMyClass()}</b><br>👩‍🎓 Learners in School: <b>${lList.length}</b> — 📚 Books in Dept: <b>${bList.length}</b> — 🏫 Classes: <b>${classes.size}</b><br>📕 Dept Issued: <b>${iList.length}</b> — ✅ Dept Returned: <b>${ret}</b> — ♻️ Dept Retrieval %: <b>${pct}%</b><br>✅ <b>HOD can approve requests in this department — Principal approves whole school.</b>`;
  }catch(e){ el.innerHTML='Report failed: '+e.message; }
}
// ===== SUBSCRIPTION — READ ONLY =====
function loadMySub(){
  let el=document.getElementById('mySub'); if(!el||!user) return; let sid=user.schoolId||'WHS';
  rtdb.ref('subscriptions/'+sid).once('value').then(snap=>{
    let s=snap.val();
    if(!s){ el.innerHTML='🆓 <b>NO SUBSCRIPTION YET — DEMO AVAILABLE</b> — Tap REQUEST DEMO → WhatsApp 078 023 3263.'; return; }
    let days=Math.ceil(((s.endDate||0)-Date.now())/86400000);
    el.innerHTML=`🏫 <b>${toCaps(s.schoolName)}</b> (${s.schoolId})<br>📦 Package: <b>${String(s.package||'').toUpperCase()}</b> — Status: <b>${String(s.status||'').toUpperCase()}</b> — Paid: <b>${s.paid?'✅ YES':'❌ NO'}</b><br>💰 Setup: <b>R${s.setup||0}</b> — Monthly: <b>R${s.monthly||0}</b> — Once-Off: <b>R${s.yearly||s.priceYear||0}</b> — Billing: <b>${s.billing||''}</b><br>📅 End: ${s.endDate?new Date(s.endDate).toDateString():'—'} — ${days>0?('Expires in <b>'+days+' days</b>'):('<b style="color:#ef4444">EXPIRED — Contact Super Admin 078 023 3263</b>')}`;
  }).catch(e=>{ el.innerHTML='Load failed: '+e.message; });
}
function loadAll(){
  if(!user) return;
  try{ if(user.subject && user.subject!=='ALL'){ document.getElementById('myDeptFilter').value=user.subject; } if(user.department && user.department!=='ALL'){ document.getElementById('myDeptFilter').value=user.department; } if(user.className && user.className!=='ALL'){ document.getElementById('myClassFilter').value=user.className; } }catch(e){}
  document.getElementById('roleInfo').innerHTML=`👤 <b>${toCaps(user.name)}</b> — HOD — RANK ${user.rank||''} — School: <b>${toCaps(user.schoolName)}</b> (${user.schoolId})<br>✅ <b>You are HOD — You approve teacher requests in your department — You see My Dept Retrieval % only — Not whole school.</b><br>📖 Department: <b>${getMyDept()}</b> — 🏫 Class: <b>${getMyClass()}</b>`;
  document.getElementById('aDept').value=getMyDept();
  loadMySub(); loadApprovals(); loadTeachers(); loadDeptReport();
}
loadAll(); loadRetrieval(); loadRetrievalByClass();
</script></body></html>
