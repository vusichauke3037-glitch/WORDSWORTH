{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'PRINCIPAL')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN')"
      }
    },

    "schools": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
    },

    "subscriptions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
    },

    "training": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
    },

    "private": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
      "marketing": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
      },
      "founder": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
      },
      "finance": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
      },
      "bank": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN'"
      }
    },

    "books": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'LIBRARIAN')"
    },

    "learners": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'LIBRARIAN')"
    },

    "issues": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'TEACHER' || root.child('users').child(auth.uid).child('role').val() == 'HOD' || root.child('users').child(auth.uid).child('role').val() == 'LIBRARIAN' || root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN')"
    },

    "requests": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'TEACHER' || root.child('users').child(auth.uid).child('role').val() == 'HOD' || root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN')"
    },

    "maxApprovals": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'HOD' || root.child('users').child(auth.uid).child('role').val() == 'SUPER_ADMIN')"
    },

    "checklists": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
